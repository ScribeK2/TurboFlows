{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turboflows.local/schemas/turboflows-workflow-v1.json",
  "title": "TurboFlows workflow import",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflows"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "exported_at": {
      "type": "string",
      "description": "Set by TurboFlows on export. Optional; ignored on import."
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "description": "This version accepts exactly one workflow per file.",
      "items": {
        "$ref": "#/$defs/workflow"
      }
    }
  },
  "$defs": {
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "steps"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "description": {
          "type": "string"
        },
        "start_step_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group_path"
          }
        },
        "folder": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "title",
            "question",
            "transitions"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "help_text": {
              "type": "string",
              "maxLength": 500
            },
            "reference_url": {
              "type": "string",
              "format": "uri"
            },
            "question": {
              "type": "string"
            },
            "answer_type": {
              "type": "string",
              "enum": [
                "text",
                "yes_no",
                "multiple_choice",
                "dropdown",
                "date",
                "number"
              ]
            },
            "variable_name": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "value"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                }
              }
            },
            "can_resolve": {
              "type": "boolean"
            },
            "transitions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/transition"
              }
            },
            "type": {
              "const": "question"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "title",
            "instructions",
            "transitions"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "help_text": {
              "type": "string",
              "maxLength": 500
            },
            "reference_url": {
              "type": "string",
              "format": "uri"
            },
            "can_resolve": {
              "type": "boolean"
            },
            "instructions": {
              "type": "string",
              "description": "HTML. Use <p>, <strong>, <em>, <ul>/<ol>/<li>, <a>. Markdown is NOT converted and will render literally."
            },
            "transitions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/transition"
              }
            },
            "type": {
              "const": "action"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "title",
            "content",
            "transitions"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "help_text": {
              "type": "string",
              "maxLength": 500
            },
            "reference_url": {
              "type": "string",
              "format": "uri"
            },
            "can_resolve": {
              "type": "boolean"
            },
            "content": {
              "type": "string",
              "description": "HTML. Use <p>, <strong>, <em>, <ul>/<ol>/<li>, <a>. Markdown is NOT converted and will render literally."
            },
            "transitions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/transition"
              }
            },
            "type": {
              "const": "message"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "title",
            "target_type",
            "transitions"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "help_text": {
              "type": "string",
              "maxLength": 500
            },
            "reference_url": {
              "type": "string",
              "format": "uri"
            },
            "target_type": {
              "type": "string",
              "enum": [
                "team",
                "queue",
                "supervisor",
                "channel",
                "department",
                "ticket"
              ]
            },
            "target_value": {
              "type": "string"
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "urgent",
                "critical"
              ]
            },
            "reason_required": {
              "type": "boolean"
            },
            "notes": {
              "type": "string",
              "description": "HTML. Use <p>, <strong>, <em>, <ul>/<ol>/<li>, <a>. Markdown is NOT converted and will render literally."
            },
            "transitions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/transition"
              }
            },
            "type": {
              "const": "escalate"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "title",
            "resolution_type"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "help_text": {
              "type": "string",
              "maxLength": 500
            },
            "reference_url": {
              "type": "string",
              "format": "uri"
            },
            "resolution_type": {
              "type": "string",
              "enum": [
                "success",
                "failure",
                "cancelled",
                "escalated",
                "transfer",
                "ticket",
                "manager_escalation"
              ]
            },
            "resolution_code": {
              "type": "string"
            },
            "notes_required": {
              "type": "boolean"
            },
            "survey_trigger": {
              "type": "boolean"
            },
            "description": {
              "type": "string",
              "description": "HTML. Use <p>, <strong>, <em>, <ul>/<ol>/<li>, <a>. Markdown is NOT converted and will render literally."
            },
            "type": {
              "const": "resolve"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "title",
            "target_workflow_title",
            "transitions"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "help_text": {
              "type": "string",
              "maxLength": 500
            },
            "reference_url": {
              "type": "string",
              "format": "uri"
            },
            "variable_mapping": {
              "type": "object"
            },
            "target_workflow_title": {
              "type": "string",
              "minLength": 1
            },
            "transitions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/transition"
              }
            },
            "type": {
              "const": "sub_flow"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "title",
            "options",
            "transitions"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "help_text": {
              "type": "string",
              "maxLength": 500
            },
            "reference_url": {
              "type": "string",
              "format": "uri"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "label"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "field_type": {
                    "type": "string",
                    "enum": [
                      "text",
                      "textarea",
                      "number",
                      "email",
                      "phone",
                      "select",
                      "checkbox"
                    ]
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "position": {
                    "type": "integer"
                  }
                }
              }
            },
            "instructions": {
              "type": "string",
              "description": "HTML. Use <p>, <strong>, <em>, <ul>/<ol>/<li>, <a>. Markdown is NOT converted and will render literally."
            },
            "transitions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/transition"
              }
            },
            "type": {
              "const": "form"
            }
          }
        }
      ]
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
        },
        "label": {
          "type": "string"
        },
        "condition": {
          "type": "string",
          "description": "One comparison only. Supported forms: var == 'value', var != 'value', var > 10, var >= 10, var < 10, var <= 10. No && or ||. Numbers must be whole and positive."
        }
      }
    },
    "group_path": {
      "description": "Either \"Support / Tier 2\" or [\"Support\", \"Tier 2\"]. Use the array form when a group name contains a slash.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    }
  }
}
