#!/bin/bash
# The replica's web entrypoint: migrate on boot, as production does, then start.
#
# The same as the repo's bin/docker-entrypoint plus one step: a replica starts
# from an empty database, and db:prepare alone never loads queue_schema.rb there
# (see below). Production's database already has those tables. Until 2026-09-14
# the repo's entrypoint also called `bin/rails db:prepare:queue`, which Rails 8.1
# doesn't have, and couldn't boot an image at all.
set -e

# .dockerignore leaves tmp/ out of the image, and Puma exits if it can't write
# tmp/pids/server.pid.
mkdir -p /rails/storage /rails/tmp/pids

# Migrates every database in config/database.yml. In production the queue shares
# the primary's DATABASE_URL, so by the time its turn comes the database already
# looks initialised and queue_schema.rb is never loaded; load it if its tables
# are missing. Rails refuses any schema load against a production database
# unless told otherwise; this one only runs when those tables don't exist.
bin/rails db:prepare
if ! bin/rails runner 'exit(ActiveRecord::Base.connection.table_exists?("solid_queue_jobs") ? 0 : 1)'; then
  DISABLE_DATABASE_ENVIRONMENT_CHECK=1 bin/rails db:schema:load:queue
fi

exec "$@"
