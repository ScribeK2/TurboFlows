<%#
  Question step body.

  Yes/No is two neutral cards. It used to carry a green check chip, a red cross
  chip, a radio dot and a label — four signifiers for one binary, with a
  polarity that is arbitrary per question ("Is the site down?" makes Yes the bad
  news). The label says which answer it is; the border says which one is chosen.

  For yes/no and multiple choice the scenario-step controller submits on
  selection, so there is no Continue button: a control that is disabled, then
  enabled, then never clicked is not a control.

  locals: step, results, next_url, stop_url, back_button, show_cancel
%>
<%= form_with url: next_url, method: :post, class: "space-y-4",
      data: { scenario_step_target: "form" } do |form| %>
  <%
    answer_type   = step.try(:answer_type)
    options       = step.try(:options)
    radio_data    = { action: "change->scenario-step#inputChanged", scenario_step_target: "input" }
  %>
  <%
    # Authors routinely set the question to the same words as the step title.
    # The shell already shows the title, so repeating it as the field label says
    # the same thing twice — exactly the redundancy this pass is removing.
    question_text = VariableInterpolator.interpolate(step.try(:question).presence || step.title, results)
    title_text    = VariableInterpolator.interpolate(step.title, results)
  %>
  <div>
    <% if question_text != title_text %>
      <label class="form-label"><%= question_text %></label>
    <% end %>

    <% if answer_type == "yes_no" %>
      <div class="radio-grid">
        <label class="radio-card">
          <%= form.radio_button :answer, "yes", required: true, data: radio_data %>
          <span class="radio-label">Yes</span>
        </label>
        <label class="radio-card">
          <%= form.radio_button :answer, "no", required: true, data: radio_data %>
          <span class="radio-label">No</span>
        </label>
      </div>

    <% elsif answer_type == "dropdown" && options.present? %>
      <%= form.select :answer,
            options.map { |opt| [runner_option_label(opt), runner_option_value(opt)] },
            { prompt: "-- Select an option --" },
            { class: "form-select", required: true, data: radio_data } %>

    <% elsif options.present? %>
      <div class="radio-list">
        <% options.each do |option| %>
          <label class="radio-card">
            <%= form.radio_button :answer, runner_option_value(option), required: true, data: radio_data %>
            <span class="radio-label"><%= runner_option_label(option) %></span>
          </label>
        <% end %>
      </div>

    <% else %>
      <%= form.text_field :answer,
            type: runner_input_type(answer_type),
            class: "form-input",
            required: true,
            placeholder: runner_input_placeholder(answer_type),
            data: { action: "input->scenario-step#inputChanged", scenario_step_target: "input" } %>
    <% end %>
  </div>

  <%= render "runner/button_bar",
        form: form, back_button: back_button, stop_url: stop_url,
        show_cancel: show_cancel,
        submit_label: (runner_auto_advances?(step) ? nil : "Continue"),
        submit_disabled: true %>
<% end %>
