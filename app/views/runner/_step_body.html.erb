<%#
  Shared runner step body — the part of the runner that is genuinely the same
  in Scenario and Player. Everything route-shaped arrives as a local, so this
  never calls a route helper and the two shells stay the only place the
  difference lives.

  locals: step, results, next_url, stop_url, back_button, show_cancel, errors,
          submitted, field_errors
%>
<%
  locals = {
    step: step, results: results, next_url: next_url, stop_url: stop_url,
    back_button: local_assigns.fetch(:back_button, nil),
    show_cancel: local_assigns.fetch(:show_cancel, true),
    errors: local_assigns.fetch(:errors, []),
    submitted: local_assigns.fetch(:submitted, {}),
    field_errors: local_assigns.fetch(:field_errors, {})
  }
%>

<%# Guidance is what the agent must not miss - mostly hard rules ("Do not
    process the delete"). It was grey text in a grey box, quieter than the
    step's own instructions; it is a labelled amber callout now, read before
    the question. The warning triangle is its alone (Escalate took
    arrow-up-circle). %>
<% if step.help_text.present? %>
  <div class="step-guidance" role="note" aria-labelledby="<%= dom_id(step, :guidance_label) %>">
    <%= icon "exclamation-triangle", class: "icon icon--sm step-guidance__icon" %>
    <div class="step-guidance__body">
      <p class="step-guidance__label" id="<%= dom_id(step, :guidance_label) %>">Guidance</p>
      <p class="step-guidance__text"><%= step.help_text %></p>
    </div>
  </div>
<% end %>

<%# A reference link is a tool opened mid-call (a ticket system, a lookup),
    so it is a button naming the site, not "More info". %>
<% if step.try(:reference_url).present? %>
  <p class="step-reference">
    <a href="<%= step.reference_url %>" target="_blank" rel="noopener"
       class="btn btn--secondary step-reference-link" title="<%= step.reference_url %>">
      <%= icon "link", class: "icon icon--xs" %>
      <span class="step-reference-link__label"><%= runner_link_label(step.reference_url) %></span>
      <%= icon "arrow-top-right-on-square", class: "icon icon--xs" %>
      <span class="sr-only">(opens in a new tab)</span>
    </a>
  </p>
<% end %>

<% if step.step_type != "message" && step.try(:description).present? %>
  <div class="text-sm mb-4"><%= render_step_content(step, 'description', results) %></div>
<% end %>

<% case step.step_type %>
<% when "question" %><%= render "runner/question", **locals %>
<% when "action" %><%= render "runner/action", **locals %>
<% when "message" %><%= render "runner/message", **locals %>
<% when "escalate" %><%= render "runner/escalate", **locals %>
<% when "resolve" %><%= render "runner/resolve", **locals %>
<% when "form" %><%= render "runner/form", **locals %>
<% when "sub_flow" %><%= render "runner/sub_flow", next_url: next_url %>
<% end %>

<% if step.respond_to?(:media_attachments) && step.media_attachments.any? %>
  <%= render "steps/media_attachments", step: step %>
<% end %>
