<%# locals: step, results, next_url, stop_url, back_button, show_cancel, errors, submitted %>
<% if step.try(:instructions).present? %>
  <div class="step-content-box step-content-box--form mb-4">
    <div class="step-content-box__accent"></div>
    <div class="step-content-box__body">
      <div class="scenario-content-layout">
        <div class="step-content-box__icon-wrap mr-3 mt-0.5">
          <%= icon "document-text", class: "icon icon--sm" %>
        </div>
        <div class="flex-1">
          <h3 class="step-content-box__label">Instructions</h3>
          <div class="text-sm"><%= render_step_content(step, 'instructions', results) %></div>
        </div>
      </div>
    </div>
  </div>
<% end %>

<%= form_with url: next_url, method: :post, class: "space-y-4",
      data: { scenario_step_target: "form" } do |form| %>
  <%= render "runner/errors", errors: errors %>
  <%= render "scenarios/form_step", step: step, submitted: submitted %>
  <%= render "runner/button_bar",
        form: form, back_button: back_button, stop_url: stop_url,
        show_cancel: show_cancel, submit_label: "Submit Form" %>
<% end %>
