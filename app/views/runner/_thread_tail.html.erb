<%#
  Whatever the run is waiting on, at the bottom of the thread.

  Exactly one of: the open card, a Resume control for a run that stopped
  somewhere it cannot rest, or the ending. Each carries id="runner-card-current"
  while the run can still move, which is the anchor a streamed answer replaces.

  locals: as runner/_thread
%>
<% if parked %>
  <li class="runner-thread__current" id="runner-card-current" data-thread-target="current">
    <%= render "runner/parked", next_url: next_url %>
  </li>
<% elsif step %>
  <%= render "runner/thread_card",
        scenario: scenario, step: step, next_url: next_url, stop_url: stop_url,
        back_button: back_button, show_cancel: show_cancel,
        errors: errors, submitted: submitted, field_errors: field_errors,
        auto_advance: auto_advance %>
<% elsif scenario.complete? %>
  <li class="runner-thread__complete-item" data-thread-target="current">
    <%= render "runner/thread_complete", results_url: results_url %>
  </li>
<% else %>
  <%# Nothing to wait on and nothing to end: the run has no step to show. A
      workflow with no steps, or a current_step uuid that no longer resolves.
      Both shells used to carry their own wording for this; it lives here now,
      so an unresolvable run says so instead of rendering an empty list. %>
  <li class="runner-thread__current" id="runner-card-current" data-thread-target="current">
    <div class="card">
      <div class="card__body" style="padding: var(--space-8); text-align: center;">
        <p class="text-sm" style="color: var(--color-ink-muted);">
          There is no step to show for this run.
        </p>
      </div>
    </div>
  </li>
<% end %>
