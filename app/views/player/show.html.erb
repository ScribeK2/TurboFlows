<% content_for(:workflow_title) { @workflow.title } %>
<% content_for(:title) { "#{@workflow.title} — Complete — TurboFlows Player" } %>

<%
  # @scenario is where the run started; @ending is where it ended. After a
  # handoff they are different frames, and how the run ended lives on the last.
  # `completed?` is the STATUS, and a stranded run's status is "completed" —
  # the frame really is finished. Reading it alone put a green check and
  # "Workflow Complete" on a call that stopped because no branch matched the
  # agent's answer. How it ended is on `outcome`, and this is the one ending
  # where the two columns disagree about whether it went well.
  is_stranded = @ending.stranded?
  is_completed = @ending.completed? && !is_stranded
  resolution = @ending.results&.dig("_resolution")
  escalation = @ending.results&.dig("_escalation")
  steps_completed = flattened_execution_path(@scenario).size
  duration = if @scenario.started_at && @ending.completed_at
    distance_of_time_in_words(@scenario.started_at, @ending.completed_at)
  elsif @scenario.started_at
    distance_of_time_in_words(@scenario.started_at, Time.current)
  end
%>

<div class="player-completion">
  <%# ── Status Icon ── %>
  <div class="player-completion__icon-wrap player-completion__icon-wrap--<%= is_completed ? 'success' : 'stopped' %>">
    <% if escalation || is_stranded %>
      <%= icon "exclamation-triangle", class: "player-completion__icon" %>
    <% elsif is_completed %>
      <%= icon "check-circle", class: "player-completion__icon" %>
    <% else %>
      <%= icon "pause-circle", class: "player-completion__icon" %>
    <% end %>
  </div>

  <%# ── Heading ── %>
  <h1 class="player-completion__title">
    <% if escalation %>
      Escalation Required
    <% elsif is_stranded %>
      No matching answer
    <% elsif is_completed %>
      Workflow Complete
    <% else %>
      Workflow Stopped
    <% end %>
  </h1>

  <%# The agent did nothing wrong and the call is not over, so say both. Naming
      the workflow rather than the agent is the whole point of the wording. %>
  <% if is_stranded %>
    <p class="player-completion__note">
      This workflow doesn&rsquo;t have a step for the answer you gave, so it stopped here.
      Nothing you did caused it &mdash; run it again to take a different path, or carry on
      and tell whoever owns this workflow.
    </p>
  <% end %>

  <%# ── Resolution/Escalation Details ── %>
  <% if resolution || escalation %>
    <div class="player-completion__details card">
      <div class="card__body">
        <% if resolution %>
          <div class="player-completion__detail-row">
            <span class="player-completion__detail-label">Resolution</span>
            <span class="badge badge--resolve"><%= resolution["type"].presence&.humanize || "Resolved" %></span>
          </div>
        <% end %>
        <% if escalation %>
          <div class="player-completion__detail-row">
            <span class="player-completion__detail-label">Escalated to</span>
            <span><%= escalation["type"] %><%= " — #{escalation["value"]}" if escalation["value"].present? %></span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# ── Stats ── %>
  <div class="player-completion__stats">
    <div class="player-completion__stat">
      <span class="player-completion__stat-value"><%= steps_completed %></span>
      <%# A one-step run is the common case for a workflow that ends early, so
          "1 Steps completed" was on screen more often than the plural. %>
      <span class="player-completion__stat-label"><%= "Step".pluralize(steps_completed) %> completed</span>
    </div>
    <% if duration %>
      <div class="player-completion__stat">
        <span class="player-completion__stat-value"><%= duration %></span>
        <span class="player-completion__stat-label">Duration</span>
      </div>
    <% end %>
    <% if resolution %>
      <% outcome_label = resolution["type"].presence&.titleize || "Resolved" %>
      <div class="player-completion__stat">
        <span class="player-completion__stat-value"><%= outcome_label %></span>
        <span class="player-completion__stat-label">Outcome</span>
      </div>
    <% end %>
  </div>

  <%# ── Actions ── %>
  <div class="player-completion__actions">
    <%= button_to "Run Again", play_workflow_path(@workflow), method: :post, class: "btn btn--primary" %>
    <%= link_to "Back to Workflows", play_path, class: "btn btn--plain" %>
  </div>
</div>
