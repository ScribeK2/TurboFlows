<% content_for(:workflow_title) { @workflow.title } %>
<% content_for(:title) { "#{@workflow.title} — TurboFlows Player" } %>

<%= render "runner/thread",
      scenario: @scenario,
      step: @open_step,
      errors: @step_errors || [],
      field_errors: @field_errors || {},
      submitted: @submitted || {},
      auto_advance: @open_step ? runner_auto_advances?(@open_step) : false,
      parked: @parked,
      **runner_locals(@scenario) %>
