<%#
  Panel Edit — step editor loaded inside the builder panel Turbo Frame.

  Local variables:
  - step: AR Step object
  - workflow: Workflow object
  - readonly: boolean (default false)
  - outline: StepOutline::Result. Optional: a caller that already built one
    (a grow's streams) passes it, so the doors and the Use existing list share
    it rather than each building their own.
%>
<% readonly = local_assigns.fetch(:readonly, false) %>
<%# panel-title spans the header and the form below it: the heading it keeps in
    step with the title field is outside that field's own form. %>
<turbo-frame id="builder-panel"
              data-builder-target="panel"
              data-controller="panel-title">
  <div class="builder__panel-header">
    <div class="builder__panel-header-left">
      <span class="builder__panel-type-badge builder__panel-type-badge--<%= step.step_type %>"><%= step_type_label(step.step_type) %></span>
      <strong data-panel-title-target="heading"><%= step.title.presence || "Untitled" %></strong>
      <%# What the panel's own autosave is doing, beside the step it describes.
          The builder header's #autosave-status is the WORKFLOW title's; step
          saves reported nowhere, which is how a refused one looked fine for
          months. inline-autosave finds it inside its own turbo-frame, so the
          settings panel could carry one too without a second mechanism.

          Rendered only for the editable panel: nothing in view mode saves.
          It starts "Saved" because that is what an unedited panel is. %>
      <% unless readonly %>
        <span class="builder__autosave builder__autosave--saved"
              data-autosave-status
              aria-live="polite">Saved</span>
      <% end %>
    </div>
    <button class="builder__panel-close"
            data-action="click->builder#closePanel"
            title="Close panel">
      <%= icon "x-mark" %>
    </button>
  </div>

  <div class="builder__panel-body"
       data-controller="step-target-picker"
       data-step-type="<%= step.step_type %>"
       data-step-id="<%= step.id %>">
    <% if readonly %>
      <%= render "steps/panel_readonly", step: step, workflow: workflow %>
    <% else %>
      <%# Built once for this panel; a Resolve has no doors and no picker. %>
      <% outline = local_assigns.fetch(:outline) { StepOutline.for(workflow) } unless step.is_a?(Steps::Resolve) %>
      <%# novalidate: autosave submits with requestSubmit(), which runs the
          browser's required-field check. An empty required field (a new
          Question's text, the row "+ Add Field" just added) made the browser
          refuse the save, move the cursor into that field and drop the edit.
          What must be filled in is WorkflowHealthCheck's to say. It goes in
          `html:`: form_with passes only id, class, data and a few others
          through as attributes and silently drops a bare `novalidate:`. %>
      <%= form_with model: step, scope: :step, url: workflow_step_path(workflow, step), method: :patch,
          html: { novalidate: true },
          data: { controller: "inline-autosave", "inline-autosave-delay-value": 2000,
                  turbo_frame: "_top", turbo_stream: true } do |f| %>

        <%# The conflict baseline for rich text, rendered by the SERVER.
            inline-autosave snapshots every other field from its input's initial
            value, which IS what the server rendered. A Lexxy editor is
            form-associated and holds its own normalisation of the body instead
            — an empty one reads "<p><br></p>" where the column holds "" — so
            snapshotting it would report a conflict on the first edit of every
            rich-text field. This carries the stored HTML, so the server
            compares what it stored against what it stores now. %>
        <% StepFieldMap.rich_text_fields(step.step_type).each do |rich_field| %>
          <%= hidden_field_tag "step[rendered][#{rich_field}]",
                               step.public_send(rich_field)&.body&.to_html.to_s,
                               id: nil, data: { autosave_rendered: "" } %>
        <% end %>

        <div class="form-group">
          <%= f.label :title, class: "form-label" %>
          <%= f.text_field :title, class: "form-input", required: true,
              placeholder: "Enter a descriptive title...",
              data: { action: "input->inline-autosave#schedule input->panel-title#update",
                      panel_title_target: "field" } %>
        </div>

        <%# Type-specific fields %>
        <%= render "steps/fields/#{step.step_type}", form: f, step: step, workflow: workflow %>

        <%= render "steps/fields/guidance", form: f, step: step %>

        <%# Connections section %>
        <% unless step.is_a?(Steps::Resolve) %>
          <div id="<%= dom_id(step, :connections) %>">
            <%= render "steps/connections", step: step, workflow: workflow, outline: outline %>
          </div>
        <% end %>
      <% end %>

      <% unless step.is_a?(Steps::Resolve) || step.hands_off? %>
        <%= render "steps/target_picker", step: step, workflow: workflow, outline: outline %>
      <% end %>

      <%# Media attaches on choose (direct upload + Steps::MediaAttachmentsController).
          It sits outside the autosave form on purpose: the form is not
          multipart and never carries file bytes. %>
      <div class="form-group"
           data-controller="media-attachments"
           data-media-attachments-url-value="<%= workflow_step_media_attachments_path(workflow, step) %>"
           data-media-attachments-direct-upload-url-value="<%= rails_direct_uploads_path %>"
           data-media-attachments-max-bytes-value="<%= Step::MAX_MEDIA_SIZE %>"
           data-media-attachments-allowed-types-value="<%= Step::ALLOWED_MEDIA_TYPES.to_json %>">
        <span class="form-label" id="<%= dom_id(step, :media_label) %>">Media attachments</span>
        <div class="file-dropzone"
             data-media-attachments-target="dropzone"
             data-action="dragover->media-attachments#dragOver dragleave->media-attachments#dragLeave drop->media-attachments#drop">
          <%= icon "cloud-arrow-up", class: "icon icon--xl file-dropzone__icon" %>
          <div class="text-sm">
            <label for="<%= dom_id(step, :media_input) %>" class="cursor-pointer font-medium">
              <span>Upload a file</span>
              <input type="file" multiple id="<%= dom_id(step, :media_input) %>" class="sr-only"
                     accept="<%= Step::ALLOWED_MEDIA_TYPES.join(",") %>"
                     aria-describedby="<%= dom_id(step, :media_label) %>"
                     data-media-attachments-target="input"
                     data-action="change->media-attachments#fileSelected">
            </label>
            <span> or drag and drop</span>
          </div>
          <p class="text-xs file-dropzone__hint">Images, videos or PDFs, up to 10 MB each</p>
        </div>
        <div data-media-attachments-target="pending" class="media-list media-list--pending"></div>
        <%= render "steps/media_list", step: step, removable: true %>
      </div>
    <% end %>
  </div>
</turbo-frame>
