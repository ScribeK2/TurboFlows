<%#
  Sub-flow step fields.
  Local variables: form (FormBuilder), step (Steps::SubFlow), workflow
%>
<div class="form-group"
     data-controller="subflow-selector"
     data-subflow-selector-current-workflow-id-value="<%= workflow.id %>">
  <%= form.label :sub_flow_workflow_id, "Target Workflow", class: "form-label" %>

  <select data-subflow-selector-target="select"
          data-action="change->subflow-selector#selectWorkflow change->inline-autosave#schedule"
          class="form-select w-full"
          name="step[sub_flow_workflow_id]">
    <option value="">-- Select a workflow --</option>
  </select>
  <%= form.hidden_field :sub_flow_workflow_id, data: { subflow_selector_target: "hiddenInput" } %>

  <p class="form-hint">
    Select a published workflow to execute as a sub-routine.
  </p>
</div>

<div id="subflow-preview">
  <%= render "steps/fields/sub_flow_preview", step: step %>
</div>

<%# Not inverted, though "tick the exception" was the first instinct. Rails'
    check_box decides its checked state by comparing the attribute to
    checked_value, and a boolean `false` does not match the string "false" — so
    an inverted box rendered UNCHECKED on a step that really was a handoff.
    Checked in the browser, not assumed.

    So the box states the default and is unticked to hand the run over.

    `data-action` is not optional here: the panel's inputs do not autosave
    without one (see TODOS.md, "A Form step's field inputs never trigger an
    autosave"), and a control that silently fails to save is worse than none. %>
<div class="form-group mt-4">
  <label class="flex items-center gap-2 cursor-pointer">
    <%= form.check_box :sub_flow_returns, class: "form-checkbox",
        data: { action: "change->inline-autosave#schedule" } %>
    <span class="text-sm">Come back to this workflow when the sub-flow finishes</span>
  </label>
  <p class="form-hint">
    Unticked, the run continues in the target workflow and ends there. This step
    then becomes the end of this workflow, so it takes no outgoing connections and
    needs no Resolve after it.
  </p>
</div>
