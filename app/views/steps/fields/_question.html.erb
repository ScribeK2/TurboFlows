<%#
  Question step fields.
  Local variables: form (FormBuilder), step (Steps::Question), workflow
%>
<div class="form-group">
  <%= form.label :question, "Question Text", class: "form-label" %>
  <%= form.text_field :question, class: "form-input", required: true,
      placeholder: "Question text. Use {{variable_name}} for earlier answers",
      data: { action: "input->inline-autosave#schedule" } %>
</div>

<div class="form-group" data-controller="question-form">
  <span class="form-label" id="<%= dom_id(step, :answer_type_label) %>">Answer type</span>
  <%= render "steps/fields/choice_cards",
        form: form, attribute: :answer_type,
        choices: Steps::Question::VALID_ANSWER_TYPES.map { |type| [answer_type_label(type), type] },
        selected: step.answer_type, labelled_by: dom_id(step, :answer_type_label),
        input_data: { question_form_target: "answerType", action: "change->question-form#handleAnswerTypeChange" } %>
  <%# Nothing is selected on a new Question, on purpose — see the note in
      _choice_cards. This line says what the choice decides, which is what a
      first-time author actually needs: only the three option-bearing types give
      a Connection something to branch on. %>
  <p class="form-hint">Pick one. Yes / No, Multiple Choice and Dropdown give this step
    answers you can branch on; the rest record what the agent typed.</p>

  <%# Options container for multiple_choice/dropdown. The autosave action sits on
      the wrapper so it covers the rows "+ Add Option" builds in JavaScript too;
      question-form fires a bubbling input event when a row is added, removed or
      moved, since none of those types into a field. %>
  <div class="mt-4 <%= 'is-hidden' unless %w[multiple_choice dropdown].include?(step.answer_type) %>"
       data-question-form-target="optionsContainer"
       data-action="input->inline-autosave#schedule change->inline-autosave#schedule">
    <label class="form-label">Options</label>
    <div data-question-form-target="optionsList" class="flex-col-gap-2">
      <% if step.options.present? && step.options.is_a?(Array) %>
        <% step.options.each do |option| %>
          <div class="option-item">
            <span class="drag-handle" title="Drag to reorder">&#9776;</span>
            <input type="text" name="step[options][][label]"
                   value="<%= option.is_a?(Hash) ? option['label'] : option %>"
                   placeholder="Option label" class="form-input flex-1">
            <input type="text" name="step[options][][value]"
                   value="<%= option.is_a?(Hash) ? option['value'] : option %>"
                   placeholder="Option value" class="form-input flex-1">
            <button type="button" class="btn btn--plain btn--sm option-item__delete"
                    data-action="click->question-form#removeOption"
                    title="Remove option">
              <%= icon "trash", class: "icon icon--sm" %>
            </button>
          </div>
        <% end %>
      <% end %>
    </div>
    <button type="button" class="btn btn--plain btn--sm mt-2"
            data-action="click->question-form#addOption">+ Add Option</button>
  </div>
</div>

<details class="step-disclosure">
  <summary class="step-disclosure__summary">
    <span class="step-disclosure__label">Variable name</span>
    <span class="step-disclosure__sep" aria-hidden="true">&middot;</span>
    <% if step.variable_name.present? %>
      <code class="step-disclosure__value"><%= step.variable_name %></code>
    <% else %>
      <span class="step-disclosure__value step-disclosure__value--auto">auto from title</span>
    <% end %>
  </summary>
  <div class="step-disclosure__body">
    <%= form.text_field :variable_name, class: "form-input",
        placeholder: "e.g., user_name, age, etc.",
        data: { action: "input->inline-autosave#schedule" } %>
    <p class="form-hint">Optional: Name this answer for use in transition conditions</p>
  </div>
</details>
