<%#
  Form step fields.
  Local variables: form (FormBuilder), step (Steps::Form), workflow
%>
<div class="form-group">
  <label class="form-label">Instructions</label>
  <%= form.rich_text_area :instructions %>
  <p class="form-hint">Explain what information the CSR should collect and why</p>
</div>

<%# The autosave action sits HERE, on the wrapper, not on each input.
    `input` and `change` both bubble, so one declaration covers every field
    control — and, crucially, the rows `form-field-builder#addField` builds in
    JavaScript, which would otherwise need the attribute added in a second place
    and stay silently unsaveable when someone forgot.

    Until this, none of these inputs carried a data-action at all: editing a
    field's label, name, required flag or its select choices fired no request,
    and the edit persisted only if the operator also touched the step title or
    instructions, whose values rode along in that save. %>
<div data-controller="form-field-builder"
     data-action="input->inline-autosave#schedule change->inline-autosave#schedule"
     data-form-field-builder-field-types-value="<%= Steps::Form::VALID_FIELD_TYPES.to_json %>">
  <span class="form-label">Form fields</span>

  <div class="form-field-list__head" aria-hidden="true">
    <span>Name</span><span>Label</span><span>Type</span><span>Required</span><span>Choices</span><span></span>
  </div>

  <div data-form-field-builder-target="fieldList" class="form-field-list">
    <% Array(step.options).each_with_index do |field, i| %>
      <div class="form-field-row" data-position="<%= i %>">
        <div class="form-field-row__inputs">
          <input type="text" name="step[options][][name]" value="<%= field['name'] %>" placeholder="field_name" class="form-input form-input--sm" aria-label="Field name">
          <input type="text" name="step[options][][label]" value="<%= field['label'] %>" placeholder="Label" class="form-input form-input--sm" aria-label="Field label">
          <select name="step[options][][field_type]" class="form-select form-select--sm" aria-label="Field type"
                  data-action="change->form-field-builder#toggleChoices">
            <% Steps::Form::VALID_FIELD_TYPES.each do |ft| %>
              <option value="<%= ft %>" <%= "selected" if field["field_type"] == ft %>><%= ft.capitalize %></option>
            <% end %>
          </select>
          <label class="form-checkbox-label">
            <input type="checkbox" name="step[options][][required]" value="true" class="form-checkbox" <%= "checked" if field["required"] %>>
            <span class="sr-only">Required</span>
          </label>
          <%# Rendered on every row, hidden unless the type is select: `options`
              posts unindexed, and a key that appears on some rows and not
              others is how that grouping goes wrong. %>
          <input type="text" name="step[options][][select_options_raw]"
                 value="<%= step.select_options_text(field) %>"
                 placeholder="Choices, comma separated"
                 class="form-input form-input--sm"
                 aria-label="Choices, comma separated"
                 data-form-field-builder-target="choices"
                 <%= "hidden" unless field["field_type"] == "select" %>>
          <input type="hidden" name="step[options][][position]" value="<%= i %>">
          <button type="button" class="btn btn--plain btn--sm form-field-row__remove" title="Remove field"
                  data-action="form-field-builder#removeField">
            <%= icon "trash", class: "icon icon--sm" %>
          </button>
        </div>
      </div>
    <% end %>
  </div>

  <button type="button" class="btn btn--secondary btn--sm mt-3" data-action="form-field-builder#addField">
    + Add Field
  </button>
</div>
