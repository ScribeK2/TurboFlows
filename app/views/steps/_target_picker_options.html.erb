<%# locals: (step:, workflow:) %>
<%#
  The dialog's candidate list, pulled out on its own so a refusal that names a
  stale target (finding 1) can re-stream just this - replacing the whole
  dialog would close it (losing the very message the refusal just wrote) and
  reopening it mid-pick would be worse. workflow.steps.ordered no longer
  includes a step that was just destroyed, so a fresh render of this partial
  is already honest with no exclusion list to pass in.

  data-step-id on the <li>, not parsed off the button's value: the "Use
  existing…" dialog's own JS (step_target_picker_controller#markGoneOptions,
  finding 3) reads it to hide an option whose step has no row left in the
  builder, without waiting for this partial to be re-rendered by the server.
%>
<% ordinals = step_ordinals(workflow) %>
<div id="<%= dom_id(step, :target_picker_options) %>">
  <ul class="step-target-list" role="list">
    <% workflow.steps.ordered.each do |candidate| %>
      <% next if candidate == step %>
      <li data-step-target-picker-target="option"
          data-step-id="<%= candidate.id %>"
          data-search="<%= "#{candidate.title} #{step_type_label(candidate.step_type)}".downcase %>">
        <button type="submit" name="target_step_id" value="<%= candidate.id %>" class="step-target-list__option">
          <span class="step-target-list__title"><%= candidate.title.presence || "Untitled #{candidate.step_type.titleize}" %></span>
          <span class="step-target-list__meta"><%= step_type_label(candidate.step_type) %> · <%= ordinals[candidate.uuid] %></span>
        </button>
      </li>
    <% end %>
  </ul>
</div>
