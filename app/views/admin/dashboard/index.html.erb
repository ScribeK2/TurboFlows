<div class="page-content">
  <!-- Header Section -->
  <div class="page-header-section">
    <h1 class="page-header-section__title">Admin Dashboard</h1>
    <p class="page-header-section__subtitle">
      Manage users, workflows, and system settings.
    </p>
  </div>

  <!-- Quick Action Buttons -->
  <div class="admin-grid mb-4">
    <%= link_to admin_users_path, class: "btn btn--secondary flex items-center gap-2 justify-center" do %>
      <%= icon "user-group", class: "icon icon--sm" %>
      Manage Users
    <% end %>
    <%= link_to admin_workflows_path, class: "btn btn--secondary flex items-center gap-2 justify-center" do %>
      <%= icon "document-text", class: "icon icon--sm" %>
      All Workflows
    <% end %>
    <%= link_to admin_groups_path, class: "btn btn--secondary flex items-center gap-2 justify-center" do %>
      <%= icon "folder", class: "icon icon--sm" %>
      Manage Groups
    <% end %>
    <%= link_to admin_analytics_path, class: "btn btn--secondary flex items-center gap-2 justify-center" do %>
      <%= icon "chart-bar", class: "icon icon--sm" %>
      Analytics
    <% end %>
    <%= link_to admin_data_health_path, class: "btn btn--secondary flex items-center gap-2 justify-center" do %>
      <%= icon "circle-stack", class: "icon icon--sm" %>
      Data Health
    <% end %>
  </div>

  <!-- Stats: one bordered panel, hairline-divided cells -->
  <div class="stat-panel">
    <div class="stat-panel__grid">
      <div class="stat-cell">
        <span class="stat-cell__label">Total Users</span>
        <p class="stat-cell__value"><%= @users_count %></p>
      </div>
      <div class="stat-cell">
        <span class="stat-cell__label">Total Workflows</span>
        <p class="stat-cell__value"><%= @workflows_count %></p>
      </div>
      <div class="stat-cell">
        <span class="stat-cell__label">Public Workflows</span>
        <p class="stat-cell__value"><%= @public_workflows_count %></p>
      </div>
    </div>
  </div>

  <!-- Recent Activity -->
  <div class="admin-grid">
    <section class="dash-section">
      <div class="dash-section__head">
        <h2 class="dash-section__title">Recent Users</h2>
        <% if @recent_users.any? %>
          <span class="dash-section__count"><%= @recent_users.size %></span>
        <% end %>
        <%= link_to "View all", admin_users_path, class: "dash-section__link" %>
      </div>
      <div class="dash-section__body">
        <% if @recent_users.any? %>
          <% @recent_users.each do |user| %>
            <div class="dash-row">
              <span class="dash-row__icon" aria-hidden="true">
                <%= icon "user-group", class: "icon icon--sm" %>
              </span>
              <div class="dash-row__body">
                <div class="dash-row__title">
                  <%= user.email %>
                  <span class="badge <%= user.avatar_role_badge_classes %>"><%= user.role.capitalize %></span>
                </div>
                <p class="dash-row__sub">Joined <%= time_ago_in_words(user.created_at) %> ago</p>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="dashboard-empty">
            <h3 class="dashboard-empty__title">No users yet</h3>
            <p class="dashboard-empty__text">Accounts appear here as people sign up.</p>
          </div>
        <% end %>
      </div>
    </section>

    <section class="dash-section">
      <div class="dash-section__head">
        <h2 class="dash-section__title">Recent Workflows</h2>
        <% if @recent_workflows.any? %>
          <span class="dash-section__count"><%= @recent_workflows.size %></span>
        <% end %>
        <%= link_to "View all", admin_workflows_path, class: "dash-section__link" %>
      </div>
      <div class="dash-section__body">
        <% if @recent_workflows.any? %>
          <% @recent_workflows.each do |workflow| %>
            <div class="dash-row">
              <span class="dash-row__icon" aria-hidden="true">
                <%= icon "document-text", class: "icon icon--sm" %>
              </span>
              <div class="dash-row__body">
                <div class="dash-row__title">
                  <%= link_to workflow.title, workflow_path(workflow) %>
                </div>
                <p class="dash-row__sub">
                  by <%= workflow.user.email %> &middot; <%= workflow.is_public? ? "Public" : "Private" %>
                  &middot; <%= time_ago_in_words(workflow.created_at) %> ago
                </p>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="dashboard-empty">
            <h3 class="dashboard-empty__title">No workflows yet</h3>
            <p class="dashboard-empty__text">Workflows created by any user will be listed here.</p>
          </div>
        <% end %>
      </div>
    </section>
  </div>
</div>
