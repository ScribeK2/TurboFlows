<div class="page-content" data-controller="admin-users" data-admin-users-total-count-value="<%= @total_count %>">
  <!-- Header Section -->
  <div class="page-header-section flex items-center justify-between gap-4 flex-wrap">
    <div>
      <h1 class="page-header-section__title">User Management</h1>
      <p class="page-header-section__subtitle">
        Manage user roles, permissions, and group assignments across the system.
      </p>
    </div>
  </div>

  <!-- Users Table -->
  <div class="card">
    <turbo-frame id="users-table" data-turbo-action="advance">
      <div class="card__header flex items-center justify-between">
        <h2>All Users</h2>
        <button type="button"
                data-admin-users-target="bulkToggleBtn"
                data-action="click->admin-users#toggleBulk"
                class="btn btn--secondary btn--sm flex items-center gap-2">
          <%= icon "user-group", class: "icon icon--sm" %>
          Bulk Assign Groups
        </button>
      </div>

      <%= render "filter_toolbar" %>

      <% if @users.any? %>
        <div class="table-wrap">
          <table class="table admin-users-table" style="table-layout: fixed;" data-admin-users-target="table">
            <colgroup>
              <%# Sized for the ~980px beside the admin sidebar. Groups is the auto
                  remainder, so the bulk-select column takes its 3rem from there.
                  Role is fixed, not a percentage: it holds a select that needs
                  121px with padding, and 16% of the 40rem minimum is 102px — at
                  390px the select ran into the Groups cell. %>
              <col class="bulk-select-column" style="width: 3rem;">
              <col style="width: 38%;">
              <col style="width: 8rem;">
              <col>
              <col style="width: 18%;">
            </colgroup>
            <thead>
              <tr>
                <th class="bulk-select-column">
                  <input type="checkbox" data-admin-users-target="selectAll" data-action="change->admin-users#toggleAll" class="form-checkbox" aria-label="Select all users on this page">
                </th>
                <th aria-sort="<%= sortable_column_aria_sort(:email, current_sort: @sort) %>">
                  <%= sortable_column_header "Email", :email, current_sort: @sort, frame: "users-table" %>
                </th>
                <th aria-sort="<%= sortable_column_aria_sort(:role, current_sort: @sort) %>">
                  <%= sortable_column_header "Role", :role, current_sort: @sort, frame: "users-table" %>
                </th>
                <%# An association: sorting it needs a join, so it stays unsorted. %>
                <th>Groups</th>
                <th aria-sort="<%= sortable_column_aria_sort(:created_at, current_sort: @sort) %>">
                  <%= sortable_column_header "Joined", :created_at, current_sort: @sort, frame: "users-table", initial: :desc %>
                </th>
              </tr>
            </thead>
            <tbody>
              <% @users.each do |user| %>
                <tr class="<%= 'admin-user-row--deactivated' if user.deactivated? %>">
                  <td class="bulk-select-column">
                    <input type="checkbox" name="user_ids[]" value="<%= user.id %>" data-admin-users-target="userCheckbox" data-action="change->admin-users#updateSelectedCount" class="form-checkbox" aria-label="Select <%= user.email %>">
                  </td>
                  <td>
                    <%# _top: the table sits in the users-table frame, and the user
                        page is a whole page, not a frame swap. %>
                    <%= link_to user.email, admin_user_path(user), class: "admin-users__email",
                          data: { turbo_frame: "_top" } %>
                    <%# Two states that both used to render as "Deactivated": an admin
                        offboarding someone, and Devise locking them out after five failed
                        sign-ins. Different causes, different fixes, different labels. %>
                    <% if user.deactivated? %>
                      <span class="badge badge--alert ml-1">Deactivated</span>
                    <% elsif user.access_locked? %>
                      <span class="badge badge--warning ml-1" title="Locked by failed sign-in attempts">Locked out</span>
                    <% end %>
                  </td>
                  <td>
                    <%# The role control is the one action left on the row: it is quick,
                        common, and says the role without a second badge. %>
                    <%= form_with url: update_role_admin_user_path(user), method: :patch, data: { turbo: false, controller: "auto-submit" }, class: "inline-flex items-center" do |form| %>
                      <%= form.select :role, options_for_select(User::ROLE_OPTIONS, user.role), {}, { id: nil, class: "form-select form-select--sm", "aria-label": "Role for #{user.email}", data: { action: "change->auto-submit#submit" } } %>
                    <% end %>
                  </td>
                  <td>
                    <%# By path, ignoring case: a plain sort put every capitalised path first. %>
                    <% entries = user.groups.map { [@group_paths.fetch(it.id, it.name), it.name] }.sort_by { |path, name| [path.downcase, name] } %>
                    <% if entries.any? %>
                      <div class="admin-users__groups">
                        <% entries.first(2).each do |path, name| %>
                          <span class="badge admin-users__group" title="<%= path %>"><%= name %></span>
                        <% end %>
                        <% if entries.size > 2 %>
                          <% all_paths = entries.map(&:first) %>
                          <span class="badge admin-users__more" title="<%= all_paths.join("\n") %>"
                                aria-label="<%= entries.size - 2 %> more: <%= all_paths.join(', ') %>">+<%= entries.size - 2 %></span>
                        <% end %>
                      </div>
                    <% else %>
                      <span class="badge badge--regular">None</span>
                    <% end %>
                  </td>
                  <td class="text-sm">
                    <%= time_ago_in_words(user.created_at) %> ago
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <%= render "pagination" if @total_count > 0 %>
      <% else %>
        <div class="empty-state p-4">
          <p class="empty-state__text">No users found</p>
        </div>
      <% end %>
    </turbo-frame>
  </div>

<%# Bulk Group Assignment Dialog — native <dialog>, opened with showModal(). %>
<dialog class="dialog" aria-labelledby="bulk-groups-title"
        data-admin-users-target="bulkModal" data-action="click->admin-users#backdropClose">
  <%= form_with url: bulk_assign_groups_admin_users_path, method: :patch, data: { admin_users_target: "bulkForm" } do |form| %>
    <div class="dialog__header">
      <h2 id="bulk-groups-title" class="dialog__title">Assign Groups</h2>
      <button type="button" class="dialog__close" data-action="admin-users#closeBulkModal">
        <span class="sr-only">Close</span>
        <%= icon "x-mark", class: "icon" %>
      </button>
    </div>

    <div class="dialog__body">
      <p class="text-sm mb-2">Replaces the groups of every selected user.</p>
      <p class="text-sm font-medium mb-3" data-admin-users-target="selectedCount">No users selected</p>
      <%= render "shared/group_picker", nodes: @group_nodes, field_name: "group_ids[]" %>
    </div>

    <div class="dialog__footer">
      <button type="button" class="btn btn--plain" data-action="admin-users#closeBulkModal">Cancel</button>
      <%= form.submit "Assign to Selected Users", class: "btn btn--primary" %>
    </div>
  <% end %>
</dialog>

<%# Bulk Action Bar (sticky bottom) %>
<div class="admin-bulk-bar is-hidden" data-admin-users-target="bulkBar">
  <span data-admin-users-target="bulkCount">0 users selected</span>
  <div class="admin-bulk-bar__actions">
    <button type="button" class="btn btn--secondary btn--sm" data-action="click->admin-users#openBulkModal">
      Assign Groups
    </button>
    <button type="button" class="btn btn--secondary btn--sm" data-action="click->admin-users#openRoleModal">
      Change Role
    </button>
    <button type="button" class="btn btn--negative btn--sm" data-action="click->admin-users#bulkDeactivate">
      Deactivate
    </button>
  </div>
</div>

<%# Bulk Role Change Dialog — native <dialog>, opened with showModal(). %>
<dialog class="dialog dialog--sm" aria-labelledby="bulk-role-title"
        data-admin-users-target="roleModal" data-action="click->admin-users#backdropClose">
  <%= form_with url: bulk_update_role_admin_users_path, method: :patch, data: { admin_users_target: "roleForm" } do |form| %>
    <div class="dialog__header">
      <h2 id="bulk-role-title" class="dialog__title">Change Role</h2>
      <button type="button" class="dialog__close" data-action="admin-users#closeRoleModal">
        <span class="sr-only">Close</span>
        <%= icon "x-mark", class: "icon" %>
      </button>
    </div>
    <div class="dialog__body">
      <%# Its own id: the filter toolbar's role select is also a form_with :role, and
          with both at id="role" this label named the filter instead (/qa ISSUE-003). %>
      <%= form.label :role, "New role for the selected users", for: "bulk_role", class: "form-label" %>
      <%= form.select :role, options_for_select(User::ROLE_OPTIONS), {}, { id: "bulk_role", class: "form-select" } %>
    </div>
    <div class="dialog__footer">
      <button type="button" class="btn btn--plain" data-action="admin-users#closeRoleModal">Cancel</button>
      <%= form.submit "Update Role", class: "btn btn--primary" %>
    </div>
  <% end %>
</dialog>

<%# Bulk Deactivate Form (hidden) %>
<%# Turbo-driven so `data-turbo-confirm` fires, matching the per-user Deactivate
    and Reactivate buttons. This was `local: true` with a native confirm() in the
    Stimulus controller — the one place in this screen that asked with browser
    chrome instead of the app's own dialog. The count is filled in by
    admin_users#bulkDeactivate, which knows how many rows are selected. %>
<%= form_with url: bulk_deactivate_admin_users_path, method: :patch,
              data: { admin_users_target: "deactivateForm" }, style: "display:none" do |form| %>
<% end %>

</div>
