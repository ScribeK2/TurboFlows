<%= form_with url: admin_users_path, method: :get, data: {
  controller: "admin-users-filter",
  turbo_frame: "users-table",
  turbo_action: "advance"
}, class: "admin-filter-toolbar" do |form| %>
  <div class="admin-filter-toolbar__controls">
    <div class="admin-filter-toolbar__search">
      <%= icon "magnifying-glass", class: "icon icon--sm admin-filter-toolbar__search-icon" %>
      <%= form.search_field :q,
        value: params[:q],
        placeholder: "Search by name or email...",
        class: "form-input admin-filter-toolbar__search-input",
        data: { admin_users_filter_target: "search", action: "input->admin-users-filter#search" },
        autocomplete: "off" %>
    </div>

    <%# One source of truth with the row select and update_role — see User::ROLE_OPTIONS %>
    <%= form.select :role,
      options_for_select([["All Roles", ""]] + User::ROLE_OPTIONS, params[:role]),
      {},
      { class: "form-select", aria: { label: "Filter by role" },
        data: { action: "change->admin-users-filter#filter" } } %>

    <%# "Waiting for a group" is User.awaiting_groups, not a group — the Overview's
        "View all" link lands on it. Groups are named by path (never a bare
        "Support"); Global is not offered, since nobody is a member of it. %>
    <%= form.select :group,
      options_for_select([["All Groups", ""], ["Waiting for a group", Admin::UsersFilter::AWAITING_GROUPS]] +
                         @group_nodes.map { [it.path, it.id] }, params[:group]),
      {},
      { class: "form-select", aria: { label: "Filter by group" },
        data: { action: "change->admin-users-filter#filter" } } %>

    <%# Sorting lives on the column headers now. The value still rides along
        here so searching or filtering does not silently reset the order. %>
    <%= form.hidden_field :sort, value: params[:sort], id: nil %>
  </div>

  <% if params[:q].present? || params[:role].present? || params[:group].present? %>
    <div class="admin-filter-pills">
      <% if params[:q].present? %>
        <span class="admin-filter-pill">
          Search: "<%= params[:q] %>"
          <%= link_to admin_users_path(filter_params_without(:q)), class: "admin-filter-pill__remove", data: { turbo_frame: "users-table" } do %>
            &times;
          <% end %>
        </span>
      <% end %>
      <% if params[:role].present? %>
        <span class="admin-filter-pill">
          Role: <%= params[:role].capitalize %>
          <%= link_to admin_users_path(filter_params_without(:role)), class: "admin-filter-pill__remove", data: { turbo_frame: "users-table" } do %>
            &times;
          <% end %>
        </span>
      <% end %>
      <% if params[:group].present? %>
        <% group_name = if params[:group].to_s == Admin::UsersFilter::AWAITING_GROUPS
                          "Waiting for a group"
                        else
                          @group_paths.fetch(params[:group].to_i, "Unknown")
                        end %>
        <span class="admin-filter-pill">
          Group: <%= group_name %>
          <%= link_to admin_users_path(filter_params_without(:group)), class: "admin-filter-pill__remove", data: { turbo_frame: "users-table" } do %>
            &times;
          <% end %>
        </span>
      <% end %>
      <%= link_to "Clear all", admin_users_path, class: "admin-filter-clear", data: { turbo_frame: "users-table" } %>
    </div>
  <% end %>

  <%# Preserve per_page in form submission %>
  <%# No id: the pagination's "Per page" select owns id="per_page", and its label
      pointed here while this field shared it. %>
  <%= form.hidden_field :per_page, value: params[:per_page], id: nil %>
<% end %>
