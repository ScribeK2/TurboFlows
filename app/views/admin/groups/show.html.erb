<div class="page-content page-narrow">
  <div class="page-header-section">
    <%= render "admin/breadcrumb", trail: admin_group_trail(@group), current: @group.name %>
    <div class="admin-group__header">
      <h1 class="page-header-section__title admin-group__title"><%= @group.name %></h1>
      <% unless @group.global? %>
        <%= link_to "Edit Group", edit_admin_group_path(@group), class: "btn btn--secondary btn--sm" %>
      <% end %>
    </div>
    <% if @group.description.present? %>
      <p class="page-header-section__subtitle"><%= @group.description %></p>
    <% end %>
    <%# Counted, not listed (spec Q16): /workflows already lists them, with
        search, folders and every action. %>
    <p class="page-header-section__ident">
      <%= pluralize(@workflow_counts.fetch(@group.id, 0), "workflow") %><%= ", including subgroups" unless @group.global? %> ·
      <%= link_to "View in Workflows", workflows_path(group_id: @group.id) %><%= " · Admins add people" if @group.admins_add_members? %>
    </p>
  </div>

  <% if @group.global? %>
    <p class="form-hint mb-4">Everyone signed in sees the published workflows in Global. It can't be renamed, moved or deleted, and it has no members or subgroups.</p>
  <% else %>
    <%= render "subgroups", group: @group, subgroups: @subgroups,
          member_counts: @member_counts, workflow_counts: @workflow_counts,
          accepts_subgroups: @group.accepts_subgroups? %>
    <%= render "members", group: @group %>
    <%= render "managers", group: @group %>
  <% end %>

  <%= render "folders", group: @group %>

  <% unless @group.global? %>
    <%= render "danger_zone", group: @group, subgroups: @subgroups.size,
          workflows: @group.group_workflows.count, members: @member_counts.fetch(@group.id, 0),
          folders: @group.folders.count %>
  <% end %>
</div>
