<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>
<div class="page-content">
  <div class="page-header-section">
    <%= link_to workflow_path(@workflow), class: "page-back" do %>
      <%= icon "chevron-left", class: "icon icon--xs" %>
      Back to workflow
    <% end %>
    <h1 class="page-header-section__title" title="<%= @workflow.title %>">
      <%= truncate(@workflow.title, length: 60, omission: "...") %>
    </h1>
    <p class="page-header-section__ident">Step-by-step execution</p>
  </div>

  <%# The thread is the history, so there is no separate trail alongside it —
      two lists of the same facts is the bug the trail was written to fix. %>
  <%# @open_step is decided by RunnerShell, so both shells open the same card. %>
  <%= render "runner/thread",
        scenario: @scenario,
        step: @open_step,
        next_url: next_step_scenario_path(@scenario),
        stop_url: stop_scenario_path(@scenario),
        back_button: scenario_back_button(@scenario),
        show_cancel: true,
        errors: @step_errors || [],
        field_errors: @field_errors || {},
        submitted: @submitted || {},
        auto_advance: @open_step ? runner_auto_advances?(@open_step) : false,
        parked: @parked,
        results_url: scenario_path(@scenario) %>
</div>
