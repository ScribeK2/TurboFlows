<%# locals: (token:, submitted_expires_in_days: nil) %>
<%# token is nil, or an unsaved ApiToken carrying validation errors and the
    scopes/expiry the author actually submitted — both are read back below so a
    refused submission never silently narrows what gets created on retry. %>
<%= form_with scope: :api_token, url: profile_api_tokens_path, id: "api-token-form", class: "space-y-4" do |f| %>
  <% if token&.errors&.any? %>
    <div class="flash flash--alert" role="alert" style="position: static;">
      <ul><% token.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, "Name", class: "form-label is-required" %>
    <%= f.text_field :name, value: token&.name, class: "form-input", maxlength: 60,
          placeholder: "Claude Code on my laptop", required: true %>
  </div>

  <fieldset class="form-group">
    <legend class="form-label">What it can do</legend>
    <label><%= check_box_tag "api_token[scopes][]", "read", token ? token.scopes.include?("read") : true,
          id: "api_token_scope_read" %> Read workflows</label>
    <% if current_user.can_create_workflows? %>
      <label><%= check_box_tag "api_token[scopes][]", "draft", token ? token.scopes.include?("draft") : false,
            id: "api_token_scope_draft" %>
        Create drafts (never publish)</label>
    <% end %>
    <% if current_user.can_create_workflows? %>
      <p class="form-hint">To let an AI write drafts, tick both. It reads the authoring guide and your workflows first.</p>
    <% end %>
  </fieldset>

  <div class="form-group">
    <%= f.label :expires_in_days, "Expires after", class: "form-label" %>
    <%= f.select :expires_in_days, ApiToken::EXPIRY_CHOICES.map { ["#{it} days", it] },
          { selected: (submitted_expires_in_days.presence || ApiToken::DEFAULT_EXPIRY_DAYS).to_i },
          class: "form-select" %>
  </div>

  <%= f.submit "Create token", class: "btn btn--secondary" %>
<% end %>
