<%# The vendored Scalar API Reference viewer (unmodified upstream file; see
    vendor/javascript/scalar-api-reference.js for the exact version, source
    and SHA-256), mounted into the layout's <main id="api-docs-viewer">. No
    importmap, no Stimulus: this page is a single self-contained script tag
    pair. %>
<%= javascript_include_tag "scalar-api-reference", nonce: true %>
<%= javascript_tag nonce: true do %>
  Scalar.createApiReference("#api-docs-viewer", {
    url: "<%= api_v1_openapi_path %>",
    // Config keys read from the vendored 1.72.1 bundle's own schema
    // (grepped out of the minified source):
    withDefaultFonts: false,
    telemetry: false,
    proxyUrl: "",
    // hideClientButton hides the "Open API Client" link, which otherwise
    // sends this document's URL — our hostname, on a corporate install — to
    // client.scalar.com. It does NOT hide "Test Request"; that's
    // hideTestRequestButton, left at its default (false) on purpose.
    hideClientButton: true,
    // Scalar's own hosted features, turned off explicitly rather than left
    // to its "only on localhost" heuristic: an internal install is reachable
    // at more than just localhost, and none of these should ever phone a
    // Scalar-hosted service with our spec or our data.
    agent: { disabled: true },
    mcp: { disabled: true },
    showDeveloperTools: "never",
    // Follow the theme the layout's bootstrap script already resolved onto
    // <html data-theme>, so the viewer never fights the app's own toggle.
    darkMode: document.documentElement.dataset.theme === "dark"
  });
<% end %>
