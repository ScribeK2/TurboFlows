<%#
  Step Row — one row in the builder step list.

  Adopts .list-row anatomy from lists.css (compact size) so the builder shares
  one row definition with the dashboard and player index. builder__step carries
  only the builder's own concerns: click target, drag slot, selected state.

  Local variables:
  - step: AR Step object
  - workflow: Workflow object
  - ordinals: { step uuid => 1-based position in the rendered list }, so the
    badge and the "→ Step N" summary agree, and neither depends on the stored
    `position` column — which is 0-based in service-built workflows and 1-based
    in UI-built ones. Optional: callers that render a row on its own (Turbo
    Stream appends) fall back to the step's own place in the workflow.
%>
<% ordinals = local_assigns.fetch(:ordinals) { step_ordinals(workflow) } %>
<% ordinal = ordinals[step.uuid] || "?" %>
<% type_label = step_type_label(step.step_type) %>
<% targets = (step.transitions.loaded? ? step.transitions : step.transitions.includes(:target_step)).filter_map(&:target_step) %>

<div class="list-row list-row--compact builder__step"
     id="<%= dom_id(step) %>"
     data-step-id="<%= step.id %>"
     data-step-uuid="<%= step.uuid %>"
     data-step-type="<%= step.step_type %>"
     data-action="click->builder#openStep"
     data-builder-url-param="<%= panel_edit_workflow_step_path(workflow, step) %>"
     role="listitem">

  <%# Drag Handle (edit mode only) %>
  <span class="drag-handle builder__edit-only"
        data-controller="tooltip" data-tooltip-text-value="Drag to reorder">
    <%= icon "bars-2", class: "icon icon--sm" %>
  </span>

  <%# Step number in a type-hued badge. The type name is not repeated as a
      separate label - it lives here, so colour is never the only signal. %>
  <span class="builder__step-badge builder__step-badge--<%= step.step_type %>"
        aria-label="<%= type_label %>"
        title="<%= type_label %>">
    <%= ordinal %>
  </span>

  <div class="list-row__body">
    <div class="list-row__title">
      <%= step.title.presence || "Untitled #{step.step_type.titleize}" %>
      <%# A handoff ends the workflow on purpose, so no connections is its shape,
          not something forgotten. %>
      <% if step.transitions.empty? && !step.is_a?(Steps::Resolve) && !step.hands_off? %>
        <span class="badge badge--warning">No connections</span>
      <% end %>
    </div>
  </div>

  <%# Status and outgoing connections sit inline rather than on a second line:
      a step list is scanned vertically, and a two-line row costs about a third
      of the steps visible at once. Mirrors how .list-row__progress sits inline.
      title= keeps the full crumb readable once CSS ellipsizes it. %>
  <% parts = [] %>
  <% parts << "Start" if step == workflow.start_step %>
  <% parts << "Terminal" if step.terminal? %>
  <% parts << step_connection_summary(targets, ordinals) if targets.any? %>
  <% meta = parts.join(" · ") %>
  <span class="builder__step-meta"<% if meta.present? %> title="<%= meta %>"<% end %>>
    <%= meta %>
  </span>

  <%# Warning Icon (populated by step_warnings_controller.js) %>
  <span class="step-warning-icon" data-step-warnings-target="icon" data-step-uuid="<%= step.uuid %>" hidden></span>

  <div class="list-row__actions builder__edit-only">
    <%= button_to workflow_step_path(workflow, step),
          method: :delete,
          data: { turbo_confirm: "Remove this step?", turbo_stream: true, action: "click->step-list#stopPropagation" },
          class: "builder__step-delete btn btn--plain btn--sm",
          title: "Remove step" do %>
      <%= icon "x-mark", class: "icon icon--sm" %>
    <% end %>
  </div>
</div>
