<%#
  Step Row — one step's own line in the builder's outline.

  Adopts .list-row anatomy from lists.css (compact size) so the builder shares
  one row definition with the dashboard and player index. builder__step carries
  only the builder's own concerns: click target and selected state.

  Where this step LEADS is not on the row: the outline around it says that
  (workflows/_step_node), with a chip per door. The row is the step itself:
  number, title, how many connections lead in, Start/Terminal, the health
  icon, Remove.

  Local variables:
  - step: AR Step object
  - workflow: Workflow object
  - outline: StepOutline::Result. Every caller in the builder passes the one
    its request built; only a row rendered on its own with none (steps#show)
    builds the workflow's own.

  Rows always render unselected. builder_controller#syncSelectedRow adds
  builder__step--selected client-side, reading data-step-id against the open
  panel — see that controller for why selection isn't decided here.
%>
<% outline = local_assigns.fetch(:outline) { StepOutline.for(workflow) } %>
<% ordinal = outline.ordinals[step.uuid] || "?" %>
<% ways_in = outline.ways_in_for(step) %>
<% type_label = step_type_label(step.step_type) %>
<% row_title = step.title.presence || "Untitled #{step.step_type.titleize}" %>

<div class="list-row list-row--compact builder__step"
     id="<%= dom_id(step) %>"
     data-step-id="<%= step.id %>"
     data-step-uuid="<%= step.uuid %>"
     data-step-type="<%= step.step_type %>"
     data-step-title="<%= row_title %>"
     data-action="click->builder#openStep"
     data-builder-url-param="<%= panel_edit_workflow_step_path(workflow, step) %>">

  <span class="builder__step-badge builder__step-badge--<%= step.step_type %>"
        aria-label="<%= type_label %>"
        title="<%= type_label %>">
    <%= ordinal %>
  </span>

  <div class="list-row__body">
    <div class="list-row__title" id="<%= dom_id(step, :title) %>">
      <%= row_title %>
    </div>
  </div>

  <%# More than one connection leads here. The outline shows the step once,
      under the door that reached it first; this says the others exist, and
      the tooltip names them. Read as part of the treeitem's name (see
      _step_node's aria-labelledby). %>
  <% if ways_in.any? %>
    <span class="builder__ways-in" id="<%= dom_id(step, :ways_in) %>"
          title="From <%= ways_in.map { |way| "step #{outline.ordinals[way.source.uuid]} · #{way.label}" }.join(", ") %>">
      <%# One inline run, so its text reads "2 ways in" on one line. With a
          panel open the words are visually hidden and the count stays; they
          remain in the treeitem's accessible name. %>
      <%= icon "link", class: "icon icon--xs" %><span><%= ways_in.size %><span class="builder__ways-in-label"> ways in</span></span>
    </span>
  <% end %>

  <% parts = [] %>
  <% parts << "Start" if step == workflow.start_step %>
  <% parts << "Terminal" if step.terminal? %>
  <% if parts.any? %>
    <span class="builder__step-meta"><%= parts.join(" · ") %></span>
  <% end %>

  <%# The treeitem's description (_step_node's aria-describedby): the badge
      shows the number and colours the type, neither of which a screen reader
      heard. %>
  <span class="sr-only" id="<%= dom_id(step, :about) %>"><%= ["Step #{ordinal}", type_label, *parts].join(", ") %></span>

  <%# Warning Icon (populated by step_warnings_controller.js) %>
  <span class="step-warning-icon" data-step-warnings-target="icon" data-step-uuid="<%= step.uuid %>" hidden></span>

  <div class="list-row__actions builder__edit-only">
    <%= button_to workflow_step_path(workflow, step),
          method: :delete,
          data: { turbo_confirm: "Remove this step?", turbo_stream: true, action: "click->step-list#stopPropagation" },
          class: "builder__step-delete btn btn--plain btn--sm",
          title: "Remove step" do %>
      <%= icon "x-mark", class: "icon icon--sm" %>
    <% end %>
  </div>
</div>
