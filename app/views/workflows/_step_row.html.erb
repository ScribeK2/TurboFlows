<%#
  Step Row — one row in the builder step list.

  Adopts .list-row anatomy from lists.css (compact size) so the builder shares
  one row definition with the dashboard and player index. builder__step carries
  only the builder's own concerns: click target, drag slot, selected state.

  Local variables:
  - step: AR Step object
  - workflow: Workflow object
  - ordinals: { step uuid => 1-based position in the rendered list }, so the
    badge and the "→ Step N" summary agree, and neither depends on the stored
    `position` column — which is 0-based in service-built workflows and 1-based
    in UI-built ones. Optional: callers that render a row on its own (Turbo
    Stream appends) fall back to the step's own place in the workflow.

  Rows always render unselected. builder_controller#syncSelectedRow adds
  builder__step--selected client-side, reading data-step-id against the open
  panel — see that controller for why selection isn't decided here.
%>
<% ordinals = local_assigns.fetch(:ordinals) { step_ordinals(workflow) } %>
<% ordinal = ordinals[step.uuid] || "?" %>
<% type_label = step_type_label(step.step_type) %>
<% doors = Step::Doors.for(step) %>
<% row_title = step.title.presence || "Untitled #{step.step_type.titleize}" %>

<div class="list-row list-row--compact builder__step"
     id="<%= dom_id(step) %>"
     data-step-id="<%= step.id %>"
     data-step-uuid="<%= step.uuid %>"
     data-step-type="<%= step.step_type %>"
     data-step-title="<%= step.title.presence || "Untitled #{step.step_type.titleize}" %>"
     data-action="click->builder#openStep"
     data-builder-url-param="<%= panel_edit_workflow_step_path(workflow, step) %>"
     role="listitem">

  <%# Drag Handle (edit mode only) %>
  <span class="drag-handle builder__edit-only"
        data-controller="tooltip" data-tooltip-text-value="Drag to reorder">
    <%= icon "bars-2", class: "icon icon--sm" %>
  </span>

  <%# Step number in a type-hued badge. The type name is not repeated as a
      separate label - it lives here, so colour is never the only signal. %>
  <span class="builder__step-badge builder__step-badge--<%= step.step_type %>"
        aria-label="<%= type_label %>"
        title="<%= type_label %>">
    <%= ordinal %>
  </span>

  <div class="list-row__body">
    <div class="list-row__title">
      <%= row_title %>
    </div>
  </div>

  <%# Status and outgoing connections sit inline rather than on a second line:
      a step list is scanned vertically, and a two-line row costs about a third
      of the steps visible at once. Mirrors how .list-row__progress sits inline.
      title= keeps the full crumb readable once CSS ellipsizes it. %>
  <% parts = [] %>
  <% parts << "Start" if step == workflow.start_step %>
  <% parts << "Terminal" if step.terminal? %>
  <% door_summary = step_door_summary(doors, ordinals) %>
  <% parts << door_summary if door_summary.present? %>
  <% meta = parts.join(" · ") %>
  <span class="builder__step-meta"<% if meta.present? %> title="<%= meta %>"<% end %>>
    <%= meta %>
  </span>

  <%# Stubs: the answers that lead nowhere yet. Not inside .builder__step-meta,
      which hides while the panel is open - and the panel is open right after a
      grow, which is exactly when the remaining stub has to be findable. Two
      doors or fewer get a button each; more collapse to one line that opens the
      panel at its doors, since a row is one line tall at rest. While the panel
      is open a stubbed row takes a second line for its stubs instead of
      overlapping the title (builder.css), but that does not raise the collapse
      threshold - 3 or more still read as one summary line, not a wider one. %>
  <% stubs = doors.stubs %>
  <% if stubs.any? %>
    <%# View mode says where an unwired answer goes today, and that is not
        always "nowhere": a blank-condition connection catches every answer
        without a door of its own. The panel's door rows say the same thing in
        the same words (steps/_doors) — when the row said "nothing yet" beside
        a panel reading "follows “Anything else”", one of them was lying. %>
    <% stub_state = doors.fallback ? "follows “Anything else”" : "nothing yet" %>
    <span class="builder__step-doors">
      <% if doors.doors.size <= 2 %>
        <% stubs.each do |door| %>
          <% stub_label = door.kind == :next ? "→" : "#{door.label} →" %>
          <button type="button" class="builder__door-stub builder__edit-only"
                  data-action="click->step-list#growFromDoor"
                  data-grow-from="<%= step.id %>"
                  data-grow-label="<%= door.label unless door.kind == :next %>"
                  data-grow-condition="<%= door.condition %>"
                  data-grow-context="<%= door.kind == :next ? "After “#{row_title}”" : "“#{row_title}” — #{door.label}" %>">
            <%= stub_label %> add step
          </button>
          <span class="builder__door-stub-text builder__view-only"><%= stub_label %> <%= stub_state %></span>
        <% end %>
      <% else %>
        <% collapsed = "#{pluralize(stubs.size, 'answer')} #{stubs.size == 1 ? 'needs' : 'need'} a step" %>
        <button type="button" class="builder__door-stub builder__edit-only"
                data-action="click->builder#openStepAtDoors"
                data-builder-url-param="<%= panel_edit_workflow_step_path(workflow, step) %>">
          <%= collapsed %>
        </button>
        <span class="builder__door-stub-text builder__view-only"><%= collapsed %></span>
      <% end %>
    </span>
  <% end %>

  <%# Warning Icon (populated by step_warnings_controller.js) %>
  <span class="step-warning-icon" data-step-warnings-target="icon" data-step-uuid="<%= step.uuid %>" hidden></span>

  <div class="list-row__actions builder__edit-only">
    <%= button_to workflow_step_path(workflow, step),
          method: :delete,
          data: { turbo_confirm: "Remove this step?", turbo_stream: true, action: "click->step-list#stopPropagation" },
          class: "builder__step-delete btn btn--plain btn--sm",
          title: "Remove step" do %>
      <%= icon "x-mark", class: "icon icon--sm" %>
    <% end %>
  </div>
</div>
