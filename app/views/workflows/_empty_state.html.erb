<%#
  Empty State — shown in the builder when a workflow has no steps.

  Keeps the real frame rather than a fake one: the list container renders as it
  always does, with a single prompt row inviting the first step. Templates are
  not duplicated here - the toolbar's Templates popover is the one place that
  action lives.

  Local variables:
  - workflow: Workflow object
%>
<div class="builder__empty" id="builder-empty-state">
  <div class="list-section__body">
    <div class="list-row list-row--compact list-row--prompt">
      <span class="list-row__icon" aria-hidden="true">
        <%= icon "plus", class: "icon icon--sm" %>
      </span>
      <div class="list-row__body">
        <div class="list-row__title">Every workflow starts with a step</div>
        <p class="list-row__sub">Steps you add will appear here, in the order an agent works through them.</p>
      </div>
    </div>
  </div>

  <div class="builder__quick-starts">
    <span class="builder__quick-starts-label">Start with</span>
    <% [
      { type: "question", label: "Question" },
      { type: "action", label: "Action" },
      { type: "message", label: "Message" }
    ].each do |qs| %>
      <%= button_to workflow_steps_path(workflow),
          method: :post,
          params: { step_type: qs[:type] },
          data: { turbo_stream: true },
          class: "btn btn--secondary btn--sm" do %>
        <%= qs[:label] %>
      <% end %>
    <% end %>

    <button type="button"
            class="btn btn--plain btn--sm"
            data-action="click->builder#focusTemplates">
      Browse templates
    </button>
  </div>
</div>
