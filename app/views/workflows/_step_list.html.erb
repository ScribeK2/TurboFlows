<%#
  Step List — builder step list with SortableJS drag-and-drop.

  Local variables:
  - workflow: Workflow object
  - steps: ordered step collection (preloaded with transitions)
%>
<div class="builder__list"
     id="step-list"
     data-controller="step-list"
     data-step-list-reorder-url-value="<%= reorder_workflow_step_path(workflow, ':id') %>">

  <div class="builder__list-scroll">
    <div id="steps-list"
         data-step-list-target="list"
         role="list">
      <% steps.each do |step| %>
        <%= render "workflows/step_row", step: step, workflow: workflow %>
      <% end %>
      <% if steps.empty? %>
        <%= render "workflows/empty_state", workflow: workflow %>
      <% end %>
    </div>
  </div>

  <%# Add Step (edit mode only) — outside the scroll area so the popover is not
      clipped. A trailing row that invites an action, per .list-row--prompt. %>
  <div class="builder__list-add-wrapper builder__edit-only">
    <button type="button"
            class="list-row list-row--compact list-row--prompt builder__list-add"
            data-action="click->step-list#toggleTypePicker">
      <span class="list-row__icon" aria-hidden="true">
        <%= icon "plus", class: "icon icon--sm" %>
      </span>
      <span class="list-row__body">
        <span class="list-row__title">Add a step</span>
      </span>
    </button>
    <%= render "workflows/type_picker", workflow: workflow %>
  </div>
</div>
