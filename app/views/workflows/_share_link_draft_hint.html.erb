<%# locals: (workflow:) %>
<%#
  A share link opens only a PUBLISHED workflow (PlayerController#show_shared
  finds it in Workflow.published), so on a draft it answers "not found" - and
  the panel used to hand the author a link to copy and send without a word
  (QA C-006, 2026-09-23).
%>
<% if workflow.draft? %>
  <p class="form-hint">This link works once this workflow is published. Until then, anyone who opens it sees “not found”.</p>
<% end %>
