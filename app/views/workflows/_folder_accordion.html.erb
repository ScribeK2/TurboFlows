<%# One expandable folder of workflows.
    Required locals: name (String), workflows (enumerable of Workflow)
    Optional locals: icon_name (default "folder"), name_class, open

    Also renders the virtual "Uncategorized" bucket, which is why the icon,
    the name styling and the initial open state are locals rather than
    hardcoded. Previously that bucket was a second copy of this markup written
    inline in index.html.erb; the copies drifted and it rendered unstyled. %>
<%
  icon_name  = local_assigns.fetch(:icon_name, "folder")
  name_class = local_assigns.fetch(:name_class, "font-semibold")
%>
<details class="folder-accordion card mb-3" <%= "open" if local_assigns[:open] %>>
  <summary class="folder-accordion__summary">
    <div class="flex items-center gap-3">
      <%# Rotates 90deg when open, via .folder-accordion[open] in workflows.css %>
      <%= icon "chevron-right", class: "icon icon--sm folder-accordion__chevron" %>

      <%= icon icon_name, class: "icon icon--sm" %>

      <span class="<%= name_class %>"><%= name %></span>
    </div>

    <span class="badge">
      <%= pluralize(workflows.size, "workflow") %>
    </span>
  </summary>

  <div class="folder-accordion__body">
    <% if workflows.any? %>
      <ul class="wf-list">
        <% workflows.each_with_index do |workflow, index| %>
          <%= render partial: "workflows/workflow_list_item", locals: { workflow: workflow, index: index } %>
        <% end %>
      </ul>
    <% else %>
      <div class="text-center py-6 text-sm">
        No workflows in this folder.
      </div>
    <% end %>
  </div>
</details>
