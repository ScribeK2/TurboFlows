<%# First / prev / numbered / next / last, plus the page-size control.
    Locals: page, total_pages, per_page

    The size control sits OUTSIDE the total_pages guard on purpose. Picking 24
    on a 10-workflow list collapses the result to a single page, and if the
    control disappeared with the nav there would be no way back to 6. %>
<%
  keep = {
    status: params[:status], search: params[:search],
    group_id: params[:group_id], sort: params[:sort],
    per_page: params[:per_page]
  }
  window = 5
  first_shown = [[page - (window / 2), 1].max, [total_pages - window + 1, 1].max].min
  last_shown  = [first_shown + window - 1, total_pages].min
%>
<div class="pagination-bar">
  <% if total_pages > 1 %>
    <nav class="pagination" aria-label="Pagination">
      <%= link_to "«", url_for(keep.merge(page: 1)),
            class: "pagination__item #{'is-disabled' if page == 1}",
            aria: { label: "First page" } %>
      <%= link_to "‹", url_for(keep.merge(page: [page - 1, 1].max)),
            class: "pagination__item #{'is-disabled' if page == 1}",
            aria: { label: "Previous page" } %>

      <% (first_shown..last_shown).each do |p| %>
        <%= link_to p, url_for(keep.merge(page: p)),
              class: "pagination__item #{'is-active' if p == page}",
              aria: { current: ("page" if p == page) } %>
      <% end %>

      <%= link_to "›", url_for(keep.merge(page: [page + 1, total_pages].min)),
            class: "pagination__item #{'is-disabled' if page == total_pages}",
            aria: { label: "Next page" } %>
      <%= link_to "»", url_for(keep.merge(page: total_pages)),
            class: "pagination__item #{'is-disabled' if page == total_pages}",
            aria: { label: "Last page" } %>

      <span class="pagination__summary">Page <%= page %> of <%= total_pages %></span>
    </nav>
  <% end %>

  <%# Changing size returns to page 1 — the old offset means nothing at a new size. %>
  <%= form_with url: workflows_path, method: :get, local: true,
        class: "pagination-bar__per-page", data: { controller: "auto-submit" } do %>
    <% keep.except(:per_page).compact_blank.each do |name, value| %>
      <%= hidden_field_tag name, value %>
    <% end %>
    <%= label_tag :per_page, "Per page", class: "pagination-bar__per-page-label" %>
    <%= select_tag :per_page,
          options_for_select(WorkflowsFilter::PER_PAGE_OPTIONS, per_page),
          class: "form-select pagination-bar__per-page-select",
          data: { action: "change->auto-submit#submit" } %>
  <% end %>
</div>
