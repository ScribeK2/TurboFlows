<%#
  Settings Panel — workflow metadata/settings in the builder panel.

  Local variables:
  - workflow: Workflow object
  - readonly: boolean (default false)
  - group_nodes: Array<Group::TreeNode>
%>
<% readonly = local_assigns.fetch(:readonly, false) %>
<turbo-frame id="builder-panel"
              data-builder-target="panel">
  <div class="builder__panel-header">
    <div class="builder__panel-header-left">
      <strong>Details</strong>
    </div>
    <button class="builder__panel-close"
            data-action="click->builder#closePanel"
            title="Close panel">
      <%= icon "x-mark" %>
    </button>
  </div>

  <div class="builder__panel-body">
    <% if readonly %>
      <div class="form-group">
        <label class="form-label">Description</label>
        <div><%= workflow.description %></div>
      </div>
      <div class="form-group">
        <label class="form-label">Who Can See This</label>
        <p><%= workflow.groups.map(&:name).join(", ").presence || "Nobody yet — only its owner and admins" %></p>
      </div>
    <% else %>
      <%= form_with model: workflow, url: workflow_path(workflow), method: :patch,
          data: { controller: "inline-autosave", "inline-autosave-delay-value": 2000,
                  turbo_frame: "_top", turbo_stream: true } do |f| %>

        <div class="form-group">
          <%= f.label :description, class: "form-label" %>
          <%= f.rich_text_area :description, class: "form-textarea" %>
        </div>

        <div class="form-group">
          <span class="form-label">Who Can See This</span>
          <%# An editor in no group is offered exactly one row — Global — so copy
              describing "a ticked group, and its subgroups" was describing a
              choice that was not on screen. Say what this person can actually
              do, and in both cases say the publish consequence: this is the
              warning the health panel and the publish refusal both name. %>
          <% only_global = group_nodes.length <= 1 %>
          <p class="form-hint">
            <% if only_global %>
              Tick Global so everyone signed in can see this. A published workflow in
              no group is visible only to you and to administrators &mdash; and publishing
              is refused until you pick one. Ask an administrator to add you to a group
              if this should go to one team rather than everyone.
            <% else %>
              People in a ticked group, and its subgroups, can see this once it is
              published. Tick Global for everyone signed in. Publishing is refused
              until at least one is ticked.
            <% end %>
          </p>
          <%# Sentinel: the key is always sent, so an empty choice reads as "no groups". %>
          <input type="hidden" name="workflow[group_ids][]" value="">
          <%= render "shared/group_picker",
                nodes: group_nodes,
                field_name: "workflow[group_ids][]",
                selected_ids: workflow.group_ids,
                input_data: { action: "change->inline-autosave#schedule" } %>
        </div>

        <div class="form-group">
          <%= render "tags/tag_selector", workflow: workflow %>
        </div>

        <%= render "workflows/sharing_panel", workflow: workflow %>

        <% if workflow.published_version.present? %>
          <div class="form-group mt-6 pt-4 border-t">
            <label class="form-label">Version</label>
            <p>v<%= workflow.published_version.version_number %> — published <%= workflow.published_version.published_at.strftime('%b %d, %Y') %></p>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
</turbo-frame>
