<div class="page-content">
  <!-- Header Section -->
  <div class="wf-page-header page-header-section">
    <div class="wf-page-header__main">
      <h1 class="page-header-section__title">Workflows</h1>
      <% if @selected_group.present? %>
        <!-- Breadcrumb -->
        <nav class="wf-breadcrumb">
          <%= link_to "Workflows", workflows_path %>
          <span>/</span>
          <%# A parent group this person cannot open is named, not linked: the link
              would lead to a refusal. %>
          <% @selected_group.ancestors.reverse.each do |ancestor| %>
            <% if @linkable_group_ids.nil? || @linkable_group_ids.include?(ancestor.id) %>
              <%= link_to ancestor.name, workflows_path(group_id: ancestor.id) %>
            <% else %>
              <span><%= ancestor.name %></span>
            <% end %>
            <span>/</span>
          <% end %>
          <span class="font-medium"><%= @selected_group.name %></span>
        </nav>
      <% end %>
    </div>
    <% if current_user&.can_create_workflows? %>
      <div class="wf-page-header__actions">
        <%= link_to new_workflow_import_path, class: "btn btn--secondary btn--sm" do %>
          <%= icon "arrow-up-tray", class: "icon icon--sm" %>
          Import
        <% end %>
        <%= start_workflow_button "New Workflow", html_class: "btn btn--primary btn--sm" %>
      </div>
    <% end %>
  </div>

  <!-- Two-Column Layout: Sidebar + Main Content -->
  <div class="wf-layout">
    <!-- Sidebar -->
    <div class="group-sidebar-wrapper">
      <%= render partial: "workflows/group_sidebar" %>
    </div>

    <!-- Main Content -->
    <div class="wf-content">
      <% if @audience_filter %>
        <p class="wf-audience-note">
          Published workflows nobody but admins and their owners can see.
          <%= link_to "Show all workflows", workflows_path %>
        </p>
      <% end %>
      <% if @owner_filter %>
        <p class="wf-audience-note">
          Showing only your workflows.
          <%= link_to "Show all", workflows_path %>
        </p>
      <% end %>
      <!-- Workflows List -->
      <% if @selected_group.present? && @folders.present? && @folders.any? %>
        <div class="card mb-4">
          <%= render "workflows/list_toolbar" %>
        </div>

        <%# Folder accordion view when a group is selected and has folders %>
        <div class="space-y-3">
          <% @folders.each do |folder| %>
            <% folder_workflows = @workflows_by_folder&.dig(folder.id) || Workflow.none %>
            <%= render partial: "workflows/folder_accordion", locals: { name: folder.name, workflows: folder_workflows } %>
          <% end %>

          <%# Workflows in this group but in none of its folders (always last, virtual) %>
          <% if @unfiled_workflows.present? && @unfiled_workflows.any? %>
            <%= render partial: "workflows/folder_accordion", locals: {
                  name: "Unfiled",
                  workflows: @unfiled_workflows,
                  icon_name: "archive-box",
                  name_class: "font-semibold italic",
                  open: true
                } %>
          <% end %>
        </div>
      <% elsif @workflows_paginated.any? %>
        <%# Flat list view (no group selected or group has no folders) %>
        <div class="card">
          <%= render "workflows/list_toolbar" %>
          <ul>
            <% @workflows_paginated.each_with_index do |workflow, index| %>
              <%= render partial: 'workflows/workflow_list_item', locals: { workflow: workflow, index: index } %>
            <% end %>
          </ul>
        </div>

        <%= render "workflows/pagination", page: @page, total_pages: @total_pages, per_page: @per_page %>
      <% else %>
        <div class="card mb-4">
          <%= render "workflows/list_toolbar" %>
        </div>

        <div class="empty-state">
          <%= icon "document-text", class: "empty-state__icon" %>
          <h3 class="empty-state__title">No workflows</h3>
          <p class="empty-state__text">
            <%# A filtered view that finds nothing must say the filter is empty,
                not that the library is. The Drafts tab used to fall through to
                "Get started by creating a new workflow" while 23 drafts existed
                — it just could not see them. %>
            <% if @audience_filter %>
              Every published workflow has an audience.
            <% elsif @owner_filter %>
              You have no workflows in this list yet.
            <% elsif @search_query.present? %>
              No workflows found matching "<%= @search_query %>"<% if @selected_group %> in <%= @selected_group.name %><% end %>.
            <% elsif @selected_group.present? %>
              No workflows in <%= @selected_group.name %>.
            <% elsif @status_filter == "draft" %>
              No drafts<%= " you can see" unless current_user&.admin? %>. Workflows stay drafts until they are published.
            <% elsif @status_filter == "published" %>
              Nothing published yet. A workflow appears here once it is published.
            <% else %>
              <%= current_user&.can_edit_workflows? ? "Get started by creating a new workflow." : "No workflows have been shared with you yet." %>
            <% end %>
          </p>
          <% if current_user&.can_create_workflows? %>
            <div class="mt-4">
              <%= start_workflow_button "New Workflow", html_class: "btn btn--secondary btn--sm" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
