<%# One numbering for the whole panel; see WorkflowsHelper#step_ordinals. %>
<% ordinals = step_ordinals(workflow) %>
<%#
  Health Panel Inner — content rendered inside the builder panel turbo-frame.

  Used by:
  - _health_panel.html.erb (wraps in turbo-frame for frame loads via src)
  - health_fixes_controller (turbo_stream.update for in-place refresh)

  Local variables:
  - workflow: Workflow object
  - health: WorkflowHealthCheck::Result
%>
<div class="builder__panel-header">
  <div class="builder__panel-header-left">
    <strong>Health</strong>
  </div>
  <button class="builder__panel-close"
          data-action="click->builder#closePanel"
          title="Close panel">
    <%= icon "x-mark" %>
  </button>
</div>

<div class="builder__panel-body">
  <% if health.clean? %>
    <%# === All Clear === %>
    <div class="health-panel__clean">
      <%= icon "check-circle", class: "icon health-panel__clean-icon" %>
      <span class="health-panel__clean-title">All checks passing</span>
    </div>

    <ul class="health-panel__checklist">
      <% [
        "Audience chosen",
        "Reachability from start",
        "Every step can reach a Resolve step",
        "All terminals are Resolve steps",
        "No circular sub-flows",
        "All required fields present",
        "Every step says something"
      ].each do |check| %>
        <li class="list-row list-row--compact">
          <%= icon "check", class: "icon health-panel__check-icon" %>
          <span class="list-row__body">
            <span class="list-row__title"><%= check %></span>
          </span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <%# === Summary === %>
    <div class="health-panel__summary">
      <% if health.summary[:errors] > 0 %>
        <span class="badge badge--alert health-panel__count">
          <%= health.summary[:errors] %> <%= "error".pluralize(health.summary[:errors]) %>
        </span>
      <% end %>
      <% if health.summary[:warnings] > 0 %>
        <span class="badge badge--warning health-panel__count">
          <%= health.summary[:warnings] %> <%= "warning".pluralize(health.summary[:warnings]) %>
        </span>
      <% end %>
    </div>

    <%# === Errors Section ===
        Ordered by what the reader can do about it, not by the order steps were
        created in — see WorkflowsHelper#health_panel_rows. Five steps added by
        hand produce eight errors, of which three carry a Fix; interleaving them
        made the list read as eight separate things wrong. %>
    <% steps_by_uuid = workflow.steps.index_by(&:uuid) %>
    <% error_rows = health_panel_rows(health) { |i| i[:severity] == :error } %>
    <% if error_rows.any? %>
      <div class="health-panel__section">
        <h4 class="health-panel__section-title">Errors</h4>
        <div class="health-panel__issues">
        <% error_rows.each do |uuid, issue| %>
          <%= render "workflows/health_issue", issue: issue, uuid: uuid, step: steps_by_uuid[uuid], workflow: workflow, ordinals: ordinals %>
        <% end %>
        </div>
      </div>
    <% end %>

    <%# === Warnings Section ===
        Readiness findings are warnings too, but they answer a different question
        and get their own section below — see READINESS_CODES. Mixing them here
        is what let "0 warnings" mean "valid" when an author read it as "ready". %>
    <% readiness = ->(issue) { WorkflowHealthCheck::READINESS_CODES.include?(issue[:code]) } %>
    <% warning_rows = health_panel_rows(health) { |i| i[:severity] == :warning && !readiness.call(i) } %>
    <% if warning_rows.any? %>
      <div class="health-panel__section">
        <h4 class="health-panel__section-title">Warnings</h4>
        <div class="health-panel__issues">
        <% warning_rows.each do |uuid, issue| %>
          <%= render "workflows/health_issue", issue: issue, uuid: uuid, step: steps_by_uuid[uuid], workflow: workflow, ordinals: ordinals %>
        <% end %>
        </div>
      </div>
    <% end %>

    <%# === Not ready for an agent ===
        The second signal. "Can this run?" is answered above; this answers "is
        this worth giving to somebody on a call?". Nothing here refuses a
        publish — publishing asks instead. %>
    <% not_ready_rows = health_panel_rows(health, &readiness) %>
    <% if not_ready_rows.any? %>
      <div class="health-panel__section">
        <h4 class="health-panel__section-title">Not ready for an agent</h4>
        <p class="health-panel__section-note">
          This workflow will run. These are the places it doesn&rsquo;t yet say anything
          useful to whoever follows it on a call. You can still publish.
        </p>
        <div class="health-panel__issues">
        <% not_ready_rows.each do |uuid, issue| %>
          <%= render "workflows/health_issue", issue: issue, uuid: uuid, step: steps_by_uuid[uuid], workflow: workflow, ordinals: ordinals %>
        <% end %>
        </div>
      </div>
    <% end %>

    <%# === Passing Checks ===
        Every row here keys on a stable finding code from WorkflowHealthCheck#add_issue,
        never on a substring of the human-readable `message` — a message is free to change
        wording without silently breaking an unrelated row. "No circular sub-flows" and
        "All required fields present" used to match message substrings ("sub-flow",
        "required") and both were already broken by it: a workflow with no terminal nodes
        (message ends "...Resolve step is required.") suppressed "All required fields
        present" though every field was fine, and a SubFlow step with no target picked yet
        (message: "Sub-flow target is required for publish") suppressed "No circular
        sub-flows" though nothing was circular. Codes replace both. %>
    <% passing_checks = [] %>
    <% issue_codes = health.issues.values.flatten.filter_map { |i| i[:code] } %>
    <% has_steps = workflow.steps.any? %>
    <% passing_checks << "Audience chosen" unless issue_codes.include?(:no_audience) %>
    <%# Every row below this line is about steps, so on an empty workflow they are
        vacuously true. Listing "Every step can reach a Resolve step" against zero
        steps reads as "you are fine" when nothing exists yet. %>
    <% passing_checks << "Reachability from start" if has_steps && !issue_codes.include?(:unreachable_step) %>
    <%# :no_outgoing_transitions stands in for both of these. A step with no
        outgoing connections IS a terminal that is not a Resolve and has no path
        to one — the health check collapses those three restatements into one
        error, so listing the checks as passing while that error is on screen
        would contradict it. %>
    <%# :no_resolve_across_workflows belongs here for the same reason. It says no
        Resolve is reachable from this workflow OR any workflow it hands off to,
        which is a strictly broader contradiction of this row than
        :no_path_to_resolve — and it is the finding that fires on the very shape
        the cross-workflow check exists to catch. Without it the panel showed the
        warning and this passing row at the same time. %>
    <% passing_checks << "Every step can reach a Resolve step" if has_steps && (issue_codes & %i[no_path_to_resolve no_outgoing_transitions no_resolve_across_workflows]).none? %>
    <% passing_checks << "All terminals are Resolve steps" if has_steps && (issue_codes & %i[terminal_not_resolve no_outgoing_transitions]).none? %>
    <% passing_checks << "No circular sub-flows" if has_steps && (issue_codes & %i[circular_subflow max_depth_exceeded subflow_target_missing]).none? %>
    <% passing_checks << "All required fields present" if has_steps && (issue_codes & %i[title_required question_text_required subflow_target_required form_field_incomplete]).none? %>
    <% passing_checks << "Every step says something" if has_steps && (issue_codes & WorkflowHealthCheck::READINESS_CODES).none? %>
    <% if passing_checks.any? %>
      <div class="health-panel__section">
        <h4 class="health-panel__section-title">Passing</h4>
        <ul class="health-panel__checklist">
          <% passing_checks.each do |check| %>
            <li><%= check %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% end %>
</div>
