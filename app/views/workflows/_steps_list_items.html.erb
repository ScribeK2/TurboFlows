<%# The list's children, re-rendered after a grow, a delete, a structural save
    or a collaborator's change. Same outline as _step_list renders. %>
<% if steps.any? %>
  <%= render "workflows/step_outline", workflow: workflow, outline: StepOutline.call(workflow, steps) %>
<% else %>
  <%= render "workflows/empty_state", workflow: workflow %>
<% end %>
