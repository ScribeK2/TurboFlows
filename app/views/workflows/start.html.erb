<div class="page-content">
  <div class="page-main">
    <%# .page-header-section supplies spacing only, so the title/action row is
        composed here with layout utilities, the same way the results page does. %>
    <div class="page-header-section">
      <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
          <%= link_to workflows_path, class: "page-back" do %>
            <%= icon "chevron-left", class: "icon icon--xs" %>
            Back to workflows
          <% end %>
          <h1 class="page-header-section__title"><%= @workflow.title %></h1>
          <p class="page-header-section__ident">
            <%= pluralize(@workflow.steps.size, "step") %><%= " · Public" if @workflow.is_public? %>
          </p>
        </div>
        <%= form_with url: workflow_execution_path(@workflow), method: :post, local: true,
              data: { controller: "form-submit", action: "submit->form-submit#submit" } do |form| %>
          <%= form.submit "Start Workflow",
                data: { form_submit_target: "submit" },
                aria: { label: "Start workflow: #{@workflow.title}" },
                class: "btn btn--primary" %>
        <% end %>
      </div>
    </div>

    <% if @workflow.description? %>
      <div class="card mb-4">
        <div class="card__body"><%= @workflow.description %></div>
      </div>
    <% end %>

    <% ar_steps = @workflow.steps.order(:position) %>
    <% if ar_steps.any? %>
      <section class="list-section">
        <div class="list-section__head">
          <h2 class="list-section__title">Steps</h2>
          <span class="list-section__count"><%= ar_steps.size %></span>
        </div>
        <div class="list-section__body">
          <% ar_steps.each do |step| %>
            <div class="list-row">
              <div class="list-row__body">
                <div class="list-row__title">
                  <%= step.title %>
                  <span class="<%= step_type_badge_classes(step.step_type) %>">
                    <%= step_type_label(step.step_type) %>
                  </span>
                </div>
                <% snippet = step.try(:question) || step.try(:content)&.to_s || step.try(:instructions)&.to_s %>
                <% if snippet.present? %>
                  <p class="list-row__sub"><%= truncate(strip_tags(snippet.to_s), length: 160) %></p>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
</div>
