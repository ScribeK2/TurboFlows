<%# locals: (dashboard:) %>
<% pinned = dashboard.pinned_workflows %>

<%# The CSR's own launcher. Workflows are pinned on /play and on Recently Run rows,
    and unpinned here in place. Workflows::PinsController replaces this whole
    section after every pin change. When "From your team" already fills the page
    and nothing is pinned, this shrinks to one line (spec
    2026-09-13-group-featured-workflows Q20). %>
<section class="list-section" id="pinned-workflows-section" aria-label="Your fast path">
  <div class="list-section__head">
    <h2 class="list-section__title">Your fast path</h2>
    <% if pinned.any? %>
      <span class="list-section__count"><%= pinned.size %></span>
      <%= link_to "Browse workflows", play_path, class: "list-section__link" %>
    <% end %>
  </div>

  <% if pinned.any? %>
    <div class="list-section__body">
      <% pinned.each do |workflow| %>
        <%= render "dashboard/launcher_row", workflow:, stats: dashboard.run_stats[workflow.id],
              icon_name: "bookmark", pinned_toggle: true %>
      <% end %>
    </div>
  <% elsif dashboard.team_sections.any? %>
    <p class="form-hint">Pin workflows you use often from <%= link_to "/play", play_path %>.</p>
  <% else %>
    <div class="list-section__body">
      <div class="dashboard-empty">
        <div class="dashboard-empty__icon">
          <%= icon "bookmark", class: "icon icon--xl" %>
        </div>
        <h3 class="dashboard-empty__title">No pinned workflows</h3>
        <p class="dashboard-empty__text">Pin your most-used flows for instant access on every call.</p>
        <div class="empty-state__actions">
          <%= link_to "Browse workflows", play_path, class: "btn btn--secondary btn--sm" %>
        </div>
      </div>
    </div>
  <% end %>
</section>
