<% pinned = dashboard.pinned_workflows %>

<section class="dash-section animate-fade-in-up" id="pinned-workflows-section" aria-label="Your fast path">
  <div class="dash-section__head">
    <h2 class="dash-section__title">Your fast path</h2>
    <% if pinned.any? %>
      <span class="dash-section__count"><%= pinned.size %></span>
    <% end %>
    <%= link_to "Manage pins", workflows_path, class: "dash-section__link" %>
  </div>

  <div class="dash-section__body">
    <% if pinned.any? %>
      <% pinned.each do |workflow| %>
        <% stats = dashboard.pinned_workflow_stats[workflow.id] || { runs: 0, last_run_at: nil } %>
        <div class="dash-row">
          <span class="dash-row__icon" aria-hidden="true">
            <%= icon "bookmark", class: "icon icon--sm" %>
          </span>
          <div class="dash-row__body">
            <div class="dash-row__title">
              <%= link_to workflow.title, workflow_path(workflow), aria: { label: "Open #{workflow.title}" } %>
            </div>
            <p class="dash-row__sub">
              <% if stats[:runs].positive? %>
                <%= pluralize(stats[:runs], "run") %><% if stats[:last_run_at] %> &middot; last run <%= time_ago_in_words(stats[:last_run_at]) %> ago<% end %>
              <% else %>
                <%= pluralize(workflow.steps.size, "step") %> &middot; never run yet
              <% end %>
            </p>
            <% if workflow.tags.any? %>
              <div class="dash-row__tags flex flex-wrap gap-1">
                <% workflow.tags.each do |tag| %>
                  <span class="tag-pill"><%= tag.name %></span>
                <% end %>
              </div>
            <% end %>
          </div>
          <div class="dash-row__actions">
            <%= button_to play_workflow_path(workflow), method: :post,
                  class: "btn btn--secondary btn--sm",
                  aria: { label: "Run #{workflow.title}" } do %>
              <%= icon "play", class: "icon icon--xs" %>
              Run
            <% end %>
          </div>
        </div>
      <% end %>

      <%= link_to workflows_path, class: "dash-row dash-row--prompt", aria: { label: "Pin a workflow" } do %>
        <span class="dash-row__icon" aria-hidden="true">
          <%= icon "plus", class: "icon icon--sm" %>
        </span>
        <div class="dash-row__body">
          <div class="dash-row__title">Pin a workflow</div>
          <p class="dash-row__sub">One-click access for your go-to flows</p>
        </div>
      <% end %>
    <% else %>
      <div class="dashboard-empty">
        <div class="dashboard-empty__icon">
          <%= icon "bookmark", class: "icon icon--xl" %>
        </div>
        <h3 class="dashboard-empty__title">No pinned workflows</h3>
        <p class="dashboard-empty__text">Pin your most-used flows for instant access on every call.</p>
        <div class="empty-state__actions">
          <%= link_to "Browse workflows", workflows_path, class: "btn btn--secondary btn--sm" %>
        </div>
      </div>
    <% end %>
  </div>
</section>
