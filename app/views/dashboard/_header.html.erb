<%# locals: (create_primary: true) %>
<%# Shared by both dashboards. Create Workflow is the page's one filled button
    only when home has no hero card to continue (spec D7). No drafts chip: for an
    admin it counted the org's drafts beside "Waiting on you" counting their own.
    No entrance animation: see test/integration/dashboard_motion_test.rb. %>
<div class="dashboard-greet">
  <div class="dashboard-greet__intro">
    <h1 class="dashboard-greet__title">
      <%= time_based_greeting(current_user) %><%= ", #{greeting_name(current_user)}" if greeting_name(current_user).present? %>
    </h1>
    <p class="dashboard-greet__subtitle"><%= greeting_date(current_user) %></p>
  </div>

  <div class="dashboard-greet__actions">
    <% if current_user.can_create_workflows? %>
      <%= start_workflow_button "Create Workflow", html_class: create_primary ? "btn btn--primary" : "btn btn--secondary" %>
    <% else %>
      <%= link_to play_path, class: "btn btn--primary", aria: { label: "Run a flow" } do %>
        <%= icon "play", class: "icon icon--sm" %>
        Run a Flow
      <% end %>
    <% end %>
  </div>
</div>
