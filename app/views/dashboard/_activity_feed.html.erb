<%# Shared by both dashboards (csr + sme).
    Locals: scenarios, empty_text %>
<% if scenarios.any? %>
  <% scenarios.each do |scenario| %>
    <% workflow = scenario.workflow %>
    <% if workflow %>
      <%= link_to scenario_path(scenario), class: "dash-row", aria: { label: "View scenario for #{workflow.title}" } do %>
        <span class="dash-row__dot dash-row__dot--<%= scenario.status %>" aria-hidden="true"></span>
        <div class="dash-row__body">
          <p class="dash-row__title"><%= workflow.title %></p>
          <p class="dash-row__sub">
            <%= scenario.status.capitalize %> &middot; <%= time_ago_in_words(scenario.created_at) %> ago
          </p>
        </div>
      <% end %>
    <% else %>
      <div class="dash-row">
        <span class="dash-row__dot" aria-hidden="true"></span>
        <div class="dash-row__body">
          <p class="dash-row__title dash-row__title--muted">Deleted workflow</p>
          <p class="dash-row__sub">
            <%= scenario.status.capitalize %> &middot; <%= time_ago_in_words(scenario.created_at) %> ago
          </p>
        </div>
      </div>
    <% end %>
  <% end %>
<% else %>
  <div class="dashboard-empty">
    <div class="dashboard-empty__icon">
      <%= icon "play", class: "icon icon--xl" %>
    </div>
    <h3 class="dashboard-empty__title">No activity yet</h3>
    <p class="dashboard-empty__text"><%= empty_text %></p>
  </div>
<% end %>
