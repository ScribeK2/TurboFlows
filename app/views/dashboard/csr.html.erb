<div class="dashboard-layout">
  <%= render "dashboard/header" %>

  <%# -- Quick Launcher (pinned workflows) -- %>
  <%= render "dashboard/pinned_workflows", dashboard: @dashboard %>

  <%# -- Two-Column Content -- %>
  <div class="dashboard-grid">
    <%# Left: Recently Run %>
    <section class="dash-section animate-fade-in-up" style="animation-delay: 0.1s;">
      <div class="dash-section__head">
        <h2 class="dash-section__title">Recently Run</h2>
        <% if @dashboard.recently_run_workflows.any? %>
          <span class="dash-section__count"><%= @dashboard.recently_run_workflows.size %></span>
        <% end %>
        <%= link_to "View all", workflows_path, class: "dash-section__link" %>
      </div>

      <div class="dash-section__body">
        <% if @dashboard.recently_run_workflows.any? %>
          <% @dashboard.recently_run_workflows.each do |scenario| %>
            <% workflow = scenario.workflow %>
            <div class="dash-row">
              <span class="dash-row__icon" aria-hidden="true">
                <%= icon "play", class: "icon icon--sm" %>
              </span>
              <div class="dash-row__body">
                <div class="dash-row__title">
                  <%= link_to workflow.title, workflow_path(workflow), aria: { label: "View workflow: #{workflow.title}" } %>
                </div>
                <p class="dash-row__sub">
                  <%= scenario.status.titleize %> &middot; last run <%= time_ago_in_words(scenario.created_at) %> ago
                </p>
                <% if workflow.tags.any? %>
                  <div class="dash-row__tags flex flex-wrap gap-1">
                    <% workflow.tags.each do |tag| %>
                      <span class="tag-pill"><%= tag.name %></span>
                    <% end %>
                  </div>
                <% end %>
              </div>
              <div class="dash-row__actions">
                <%= render "workflows/pin_button", workflow: workflow,
                      pinned: @dashboard.pinned_workflow_ids.include?(workflow.id), location: "recent" %>
                <%= button_to play_workflow_path(workflow), method: :post,
                      class: "btn btn--secondary btn--sm", aria: { label: "Re-run #{workflow.title}" } do %>
                  <%= icon "play", class: "icon icon--xs" %>
                  Re-run
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="dashboard-empty">
            <div class="dashboard-empty__icon">
              <%= icon "play", class: "icon icon--xl" %>
            </div>
            <h3 class="dashboard-empty__title">Nothing run yet</h3>
            <p class="dashboard-empty__text">Workflows you run will be listed here so you can pick them back up fast.</p>
          </div>
        <% end %>
      </div>
    </section>

    <%# Right: Recent Activity %>
    <section class="dash-section animate-fade-in-up" style="animation-delay: 0.15s;">
      <div class="dash-section__head">
        <h2 class="dash-section__title">Recent Activity</h2>
        <% if @dashboard.recent_scenarios.any? %>
          <span class="dash-section__count"><%= @dashboard.recent_scenarios.size %></span>
        <% end %>
      </div>

      <div class="dash-section__body">
        <%= render "dashboard/activity_feed", scenarios: @dashboard.recent_scenarios,
              empty_text: "Scenarios you run will show up here as they happen." %>
      </div>
    </section>
  </div>
</div>
