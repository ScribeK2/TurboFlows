<%# No Turbo preview and no entrance animation: returning here must render once.
    See test/integration/dashboard_motion_test.rb. %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-preview">
<% end %>

<%# The CSR home is the viewer's own: a call to pick back up, their pins, the
    workflows they recently started. Browsing and pinning are /play.

    No workflow title here is a link. A Regular user has no page for a workflow
    (WorkflowsController and ScenariosController are closed to them), and
    POST /play/:id starts a live call, so the Run buttons are the only way in.
    test/integration/csr_home_links_test.rb follows every link on this page as a
    Regular user (spec 2026-09-13). %>
<div class="dashboard-layout">
  <%= render "dashboard/header" %>

  <%= render "dashboard/group_notice" %>

  <%= render "dashboard/resume", resume: @dashboard.resume %>

  <%= render "dashboard/team_workflows", dashboard: @dashboard %>

  <%= render "dashboard/pinned_workflows", dashboard: @dashboard %>

  <%= render "dashboard/recently_run", dashboard: @dashboard %>
</div>
