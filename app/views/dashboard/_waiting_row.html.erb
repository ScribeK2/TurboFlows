<%# locals: (id:, icon_name:, title:, workflows:, total:, more_path:, sub: nil) %>
<div class="list-row" id="<%= id %>">
  <span class="list-row__icon" aria-hidden="true"><%= icon icon_name, class: "icon icon--sm" %></span>
  <div class="list-row__body">
    <div class="list-row__title"><%= title %></div>
    <% if sub %>
      <p class="list-row__sub"><%= sub %></p>
    <% end %>
    <ul class="admin-attention__people">
      <% workflows.each do |workflow| %>
        <li><%= link_to workflow.title, workflow_open_path(workflow) %></li>
      <% end %>
      <% if total > workflows.size %>
        <li><%= link_to "+#{total - workflows.size} more", more_path %></li>
      <% end %>
    </ul>
  </div>
</div>
