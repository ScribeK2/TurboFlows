<div class="dashboard-layout">
  <%= render "dashboard/header" %>

  <%= render "dashboard/group_notice" %>

  <% if @dashboard.published_workflow_count.positive? || @dashboard.draft_count.positive? %>
  <%# -- Stats: one bordered panel, hairline-divided cells -- %>
  <div class="stat-panel animate-fade-in">
    <div class="stat-panel__grid">
      <div class="stat-cell" aria-label="Published workflows: <%= @dashboard.published_workflow_count %>">
        <div class="stat-cell__head">
          <span class="stat-cell__label">Published Workflows</span>
        </div>
        <p class="stat-cell__value"><%= @dashboard.published_workflow_count %></p>
      </div>

      <div class="stat-cell" aria-label="Scenarios this week: <%= @dashboard.visible_scenarios_this_week %>">
        <div class="stat-cell__head">
          <span class="stat-cell__label">Scenarios This Week</span>
        </div>
        <p class="stat-cell__value"><%= @dashboard.visible_scenarios_this_week %></p>
      </div>

      <div class="stat-cell" aria-label="Total scenarios: <%= @dashboard.visible_scenario_total %>">
        <div class="stat-cell__head">
          <span class="stat-cell__label">Total Scenarios</span>
        </div>
        <p class="stat-cell__value"><%= number_with_delimiter(@dashboard.visible_scenario_total) %></p>
      </div>

      <div class="stat-cell" aria-label="Completion rate: <%= @dashboard.visible_completion_rate %>%">
        <div class="stat-cell__head">
          <span class="stat-cell__label">Completion Rate</span>
        </div>
        <p class="stat-cell__value"><%= @dashboard.visible_completion_rate %>%</p>
        <div class="stat-cell__bar" aria-hidden="true">
          <span style="width: <%= @dashboard.visible_completion_rate %>%"></span>
        </div>
      </div>
    </div>
  </div>
  <% end %>

  <%# -- Two-Column Content -- %>
  <div class="dashboard-grid">
    <%# Left: Recent Workflows %>
    <section class="list-section animate-fade-in-up" style="animation-delay: 0.1s;">
      <div class="list-section__head">
        <h2 class="list-section__title">Recent Workflows</h2>
        <% if @dashboard.workflows.any? %>
          <span class="list-section__count"><%= @dashboard.workflows.size %></span>
        <% end %>
        <%= link_to "View all", workflows_path, class: "list-section__link", aria: { label: "View all workflows" } %>
      </div>

      <div class="list-section__body">
        <% if @dashboard.workflows.any? %>
          <% @dashboard.workflows.each do |workflow| %>
            <div class="list-row">
              <span class="list-row__icon" aria-hidden="true">
                <%= icon "document-text", class: "icon icon--sm" %>
              </span>
              <div class="list-row__body">
                <div class="list-row__title">
                  <%= link_to workflow.title, workflow_open_path(workflow), aria: { label: "Open workflow: #{workflow.title}" } %>
                  <%= workflow_status_badge(workflow) %>
                </div>
                <p class="list-row__sub">Created <%= time_ago_in_words(workflow.created_at) %> ago</p>
                <% if workflow.tags.any? %>
                  <div class="list-row__tags flex flex-wrap gap-1">
                    <% workflow.tags.each do |tag| %>
                      <span class="tag-pill"><%= tag.name %></span>
                    <% end %>
                  </div>
                <% end %>
              </div>
              <div class="list-row__actions">
                <% if workflow.published? %>
                  <%= button_to "Run", play_workflow_path(workflow), method: :post,
                        class: "btn btn--plain btn--sm",
                        aria: { label: "Run workflow: #{workflow.title}" } %>
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="dashboard-empty">
            <div class="dashboard-empty__icon">
              <%= icon "document-text", class: "icon icon--xl" %>
            </div>
            <h3 class="dashboard-empty__title">No workflows yet</h3>
            <p class="dashboard-empty__text">Workflows you create will be listed here, newest first. Use Create Workflow above to start one.</p>
          </div>
        <% end %>
      </div>
    </section>

    <%# Right: Recent Activity %>
    <section class="list-section animate-fade-in-up" style="animation-delay: 0.15s;">
      <div class="list-section__head">
        <h2 class="list-section__title">Recent Activity</h2>
        <%# Company-wide, matching the three stat cards above it. This was
            `recent_scenarios`, which is scoped to the current user, so a fresh
            admin saw "Total Scenarios 115" beside "No activity yet — scenarios
            run by your team will appear here". The copy was right; the query
            was not. %>
        <% if @dashboard.visible_recent_scenarios.any? %>
          <span class="list-section__count"><%= @dashboard.visible_recent_scenarios.size %></span>
        <% end %>
      </div>

      <div class="list-section__body">
        <%= render "dashboard/activity_feed", scenarios: @dashboard.visible_recent_scenarios,
              empty_text: "Scenarios run by your team will appear here as they happen." %>
      </div>
    </section>
  </div>
</div>
