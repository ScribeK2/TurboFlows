<div class="dashboard-layout">
  <%= render "dashboard/header" %>

  <%# -- Stats: one bordered panel, hairline-divided cells -- %>
  <div class="stat-panel animate-fade-in">
    <div class="stat-panel__grid">
      <div class="stat-cell" aria-label="Total workflows: <%= @dashboard.workflow_count %>">
        <div class="stat-cell__head">
          <span class="stat-cell__label">Active Workflows</span>
          <% if @dashboard.draft_count.positive? %>
            <span class="stat-cell__chip"><%= @dashboard.draft_count %> draft<%= @dashboard.draft_count == 1 ? "" : "s" %></span>
          <% end %>
        </div>
        <p class="stat-cell__value"><%= @dashboard.workflow_count %></p>
        <% published = @dashboard.workflow_count - @dashboard.draft_count %>
        <% if published.positive? %>
          <p class="stat-cell__detail"><%= published %> published</p>
        <% end %>
      </div>

      <div class="stat-cell" aria-label="Scenarios this week: <%= @dashboard.company_scenarios_this_week %>">
        <div class="stat-cell__head">
          <span class="stat-cell__label">Scenarios This Week</span>
          <% if @dashboard.scenario_active.positive? %>
            <span class="stat-cell__chip"><%= @dashboard.scenario_active %> live</span>
          <% end %>
        </div>
        <p class="stat-cell__value"><%= @dashboard.company_scenarios_this_week %></p>
      </div>

      <div class="stat-cell" aria-label="Total scenarios: <%= @dashboard.company_scenario_total %>">
        <div class="stat-cell__head">
          <span class="stat-cell__label">Total Scenarios</span>
        </div>
        <p class="stat-cell__value"><%= number_with_delimiter(@dashboard.company_scenario_total) %></p>
      </div>

      <div class="stat-cell" aria-label="Completion rate: <%= @dashboard.company_completion_rate %>%">
        <div class="stat-cell__head">
          <span class="stat-cell__label">Completion Rate</span>
        </div>
        <p class="stat-cell__value"><%= @dashboard.company_completion_rate %>%</p>
        <div class="stat-cell__bar" aria-hidden="true">
          <span style="width: <%= @dashboard.company_completion_rate %>%"></span>
        </div>
      </div>
    </div>
  </div>

  <%# -- Two-Column Content -- %>
  <div class="dashboard-grid">
    <%# Left: Recent Workflows %>
    <section class="list-section animate-fade-in-up" style="animation-delay: 0.1s;">
      <div class="list-section__head">
        <h2 class="list-section__title">Recent Workflows</h2>
        <% if @dashboard.workflows.any? %>
          <span class="list-section__count"><%= @dashboard.workflows.size %></span>
        <% end %>
        <%= link_to "View all", workflows_path, class: "list-section__link", aria: { label: "View all workflows" } %>
      </div>

      <div class="list-section__body">
        <% if @dashboard.workflows.any? %>
          <% @dashboard.workflows.each do |workflow| %>
            <div class="list-row">
              <span class="list-row__icon" aria-hidden="true">
                <%= icon "document-text", class: "icon icon--sm" %>
              </span>
              <div class="list-row__body">
                <div class="list-row__title">
                  <%= link_to workflow.title, workflow_path(workflow), aria: { label: "View workflow: #{workflow.title}" } %>
                  <%= workflow_status_badge(workflow) %>
                </div>
                <p class="list-row__sub">Created <%= time_ago_in_words(workflow.created_at) %> ago</p>
                <% if workflow.tags.any? %>
                  <div class="list-row__tags flex flex-wrap gap-1">
                    <% workflow.tags.each do |tag| %>
                      <span class="tag-pill"><%= tag.name %></span>
                    <% end %>
                  </div>
                <% end %>
              </div>
              <div class="list-row__actions">
                <%= link_to "View", workflow_path(workflow), class: "btn btn--secondary btn--sm",
                      aria: { label: "View workflow: #{workflow.title}" } %>
                <% if workflow.can_be_edited_by?(current_user) %>
                  <%= link_to "Edit", edit_workflow_path(workflow), class: "btn btn--secondary btn--sm",
                        aria: { label: "Edit workflow: #{workflow.title}" } %>
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="dashboard-empty">
            <div class="dashboard-empty__icon">
              <%= icon "document-text", class: "icon icon--xl" %>
            </div>
            <h3 class="dashboard-empty__title">No workflows yet</h3>
            <p class="dashboard-empty__text">Workflows you create will be listed here, newest first.</p>
            <div class="empty-state__actions">
              <%= link_to new_workflow_path, class: "btn btn--secondary btn--sm", aria: { label: "Create your first workflow" } do %>
                <%= icon "plus", class: "icon icon--xs" %>
                Create Workflow
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </section>

    <%# Right: Recent Activity %>
    <section class="list-section animate-fade-in-up" style="animation-delay: 0.15s;">
      <div class="list-section__head">
        <h2 class="list-section__title">Recent Activity</h2>
        <% if @dashboard.recent_scenarios.any? %>
          <span class="list-section__count"><%= @dashboard.recent_scenarios.size %></span>
        <% end %>
      </div>

      <div class="list-section__body">
        <%= render "dashboard/activity_feed", scenarios: @dashboard.recent_scenarios,
              empty_text: "Scenarios run by your team will appear here as they happen." %>
      </div>
    </section>
  </div>
</div>
