<div class="card" id="workflow-usage">
  <div class="card__header">
    <h3>Workflow Usage</h3>
  </div>
  <% if @workflow_stats.any? %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Workflow</th>
            <th>Total Runs</th>
            <th>Completion Rate</th>
            <th>Avg Duration</th>
            <th>Escalation Rate</th>
            <th>Last Run</th>
          </tr>
        </thead>
        <tbody>
          <% @workflow_stats.each do |row| %>
            <% total = row.total_runs.to_i %>
            <%# Rates over finished runs, as the headline does (spec Q71); a
                workflow with none yet has no rate, not a 0% one. %>
            <% finished = row.finished_runs.to_i %>
            <tr>
              <td class="font-medium">
                <% if analytics_links_workflow?(row.workflow_id) %>
                  <%= link_to row.workflow_title, workflow_path(row.workflow_id) %>
                <% else %>
                  <%= row.workflow_title %>
                <% end %>
              </td>
              <td><%= number_with_delimiter(total) %></td>
              <td><%= finished.positive? ? "#{(row.completed_count.to_f / finished * 100).round(1)}%" : "—" %></td>
              <td>
                <% avg = row.avg_duration.to_i %>
                <%= avg > 60 ? "#{avg / 60}m #{avg % 60}s" : "#{avg}s" %>
              </td>
              <td><%= finished.positive? ? "#{(row.escalated_count.to_f / finished * 100).round(1)}%" : "—" %></td>
              <td><%= analytics_last_seen(@last_runs[row.workflow_id]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state p-4">
      <h3 class="empty-state__title">No workflow data for this period</h3>
      <p class="empty-state__text">Workflow usage stats appear after scenarios are run.</p>
    </div>
  <% end %>
</div>
