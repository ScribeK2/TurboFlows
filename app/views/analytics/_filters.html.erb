<%= form_tag analytics_path, method: :get, class: "card card__body mb-4", data: { controller: "analytics-filters" } do %>
  <div class="flex flex-wrap items-end gap-4">
    <%# Date Range %>
    <div>
      <label class="form-label text-xs uppercase tracking-wider mb-2">Date Range</label>
      <div class="wf-status-tabs" role="group" aria-label="Date range">
        <% current_range = @current_range %>
        <% @ranges.each do |range| %>
          <% active = current_range == range %>
          <button type="button"
                  class="wf-status-tabs__tab <%= "is-active" if active %>"
                  aria-pressed="<%= active %>"
                  data-action="click->analytics-filters#selectRange"
                  data-value="<%= range %>">
            <%= range == "all" ? "All time" : range %>
          </button>
        <% end %>
      </div>
    </div>

    <%# Everything below narrows individual runs. The all-time view holds daily
        totals per workflow, so it cannot answer "which agent" or "which group"
        at all — the controls are hidden rather than shown inert, and the range
        hint above says why. %>
    <% unless @rollup_mode %>
    <%# Purpose %>
    <div>
      <label class="form-label text-xs uppercase tracking-wider mb-2">Purpose</label>
      <div class="wf-status-tabs" role="group" aria-label="Purpose">
        <% current_purpose = params[:purpose] || "all" %>
        <% %w[all simulation live].each do |purpose| %>
          <% active = current_purpose == purpose %>
          <button type="button"
                  class="wf-status-tabs__tab <%= "is-active" if active %>"
                  aria-pressed="<%= active %>"
                  data-action="click->analytics-filters#selectPurpose"
                  data-value="<%= purpose %>">
            <%= purpose.capitalize %>
          </button>
        <% end %>
      </div>
    </div>

    <%# Workflow %>
    <div>
      <label class="form-label text-xs uppercase tracking-wider mb-2">Workflow</label>
      <%= select_tag :workflow_id,
            options_from_collection_for_select(@workflows_for_filter, :id, :title, params[:workflow_id]&.to_i),
            include_blank: "All Workflows",
            class: "form-select",
            onchange: "this.form.requestSubmit()" %>
    </div>

    <%# User %>
    <div>
      <label class="form-label text-xs uppercase tracking-wider mb-2">Agent</label>
      <%= select_tag :user_id,
            options_from_collection_for_select(@users_for_filter, :id, :email, params[:user_id]&.to_i),
            include_blank: "All Agents",
            class: "form-select",
            onchange: "this.form.requestSubmit()" %>
    </div>

    <%# Group %>
    <% if @show_group_filter %>
    <div>
      <label class="form-label text-xs uppercase tracking-wider mb-2">Group</label>
      <%= select_tag :group_id,
            options_for_select(@groups_for_filter.map { [it.path, it.id] }, params[:group_id]&.to_i),
            include_blank: "All Groups",
            class: "form-select",
            onchange: "this.form.requestSubmit()" %>
    </div>
    <% end %>

    <% end %>

    <%# Hidden fields for filter state %>
    <% current_purpose ||= params[:purpose] || "all" %>
    <%= hidden_field_tag :range, current_range, data: { analytics_filters_target: "rangeField" } %>
    <%= hidden_field_tag :purpose, current_purpose, data: { analytics_filters_target: "purposeField" } %>
    <%= hidden_field_tag :tab, params[:tab] || "0", data: { analytics_filters_target: "tabField" } %>
  </div>

  <%# "All time" is a different SOURCE, not a wider window on the same one:
      runs are deleted at the retention horizon, so it reads the daily rollups
      instead. The seam is explicit rather than stitched — a blended view would
      be exact for recent ranges and quietly partial for older ones, which is
      the failure this replaced. The hint sits under the whole row: inside the
      Date Range column it made that column taller, and items-end dropped every
      control beside it to the hint's baseline. %>
  <p class="form-hint mt-3">
    <% if @rollup_mode %>
      Daily totals, kept indefinitely<%= " since #{l(@rollup_earliest_day, format: :long)}" if @rollup_earliest_day %>.
      <%# Days rolled up before calls were counted carry none (ISSUE-003); saying
          where the count begins keeps a shorter history from reading as less
          activity. %>
      <% if @calls_counted_from %>
        Calls are counted from <%= l(@calls_counted_from, format: :long) %>.
      <% else %>
        Calls are counted from the next nightly rollup.
      <% end %>
      Individual runs are deleted after <%= Scenario.live_retention_days %> days, so
      per-agent, per-step and time-of-day views are unavailable here.
    <% else %>
      Individual runs, with every filter. They are deleted after
      <%= Scenario.live_retention_days %> days (live) and
      <%= Scenario.simulation_retention_days %> days (simulation)<% if @ranges.include?("all") %> &mdash; choose
      &ldquo;All time&rdquo; for daily totals reaching further back<% end %>.
    <% end %>
  </p>
<% end %>
