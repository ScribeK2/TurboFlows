<div class="flex flex-col gap-6">
  <%# Outcome Breakdown %>
  <div class="card" id="outcome-breakdown">
    <div class="card__header">
      <h3>Outcome Breakdown</h3>
    </div>
    <% if @outcome_breakdown.any? %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Outcome</th>
              <th>Count</th>
              <th>% of Total</th>
            </tr>
          </thead>
          <tbody>
            <% @outcome_breakdown.each do |outcome, count| %>
              <% pct = @total_calls > 0 ? (count.to_f / @total_calls * 100).round(1) : 0 %>
              <%# The bar carries the outcome's hue; the label is plain text, since a
                  pill here would make every row an exception. %>
              <% bar_class = analytics_outcome_bar_class(outcome) %>
              <tr>
                <td><%= analytics_outcome_label(outcome) %></td>
                <td><%= number_with_delimiter(count) %></td>
                <td>
                  <div class="flex items-center gap-3">
                    <div class="analytics-bar-track">
                      <div class="analytics-bar <%= bar_class %>" style="width: <%= pct %>%"></div>
                    </div>
                    <span class="tabular-nums"><%= pct %>%</span>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state p-4">
        <h3 class="empty-state__title">No scenario data for this period</h3>
        <p class="empty-state__text">Run workflows to see outcome breakdowns here.</p>
      </div>
    <% end %>
  </div>

  <%# Calls Over Time: each call once, on the day it started %>
  <div class="card">
    <div class="card__header">
      <h3>Calls Over Time</h3>
    </div>
    <% if @calls_over_time.any? %>
      <% max_runs = @calls_over_time.values.max %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th class="w-48">Period</th>
              <th>Calls</th>
            </tr>
          </thead>
          <tbody>
            <% @calls_over_time.sort.each do |period, count| %>
              <% bar_pct = max_runs > 0 ? (count.to_f / max_runs * 100).round : 0 %>
              <tr>
                <td>
                  <% date = period.is_a?(Date) ? period : Date.parse(period.to_s) %>
                  <%= @runs_grouped_by_week ? "Week of #{date.strftime("%b %-d, %Y")}" : date.strftime("%b %-d, %Y") %>
                </td>
                <td>
                  <div class="flex items-center gap-3">
                    <div class="analytics-bar-track">
                      <div class="analytics-bar analytics-bar--default" style="width: <%= bar_pct %>%"></div>
                    </div>
                    <span class="tabular-nums font-medium w-8 text-right"><%= number_with_delimiter(count) %></span>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state p-4">
        <h3 class="empty-state__title">No scenario data for this period</h3>
        <p class="empty-state__text">Activity trends will appear as scenarios are run.</p>
      </div>
    <% end %>
  </div>
</div>
