<%# locals: (group:, featured:, visible_ids:, query: "", candidates: Workflow.none, moved_id: nil, moved_direction: nil) %>
<%# A team's featured workflows (spec 2026-09-13-group-featured-workflows), in
    the order members get them: drag, or Move up / Move down. A row members
    can't see stays listed with the warning pill and holds no place (Q18). A
    visible row past the first 8 says so in plain text, since members can still
    run it from /play. teams/featured_workflows/changed replaces this section whole. %>
<% visible_count = featured.count { visible_ids.include?(it.workflow_id) } %>
<% kit = GroupFeaturedWorkflow.kit(featured, visible_ids) %>
<section id="team-featured" class="card mb-4" aria-labelledby="team-featured-heading">
  <div class="card__body">
    <h2 id="team-featured-heading" class="admin-card__heading">Featured workflows</h2>
    <p class="form-hint mb-3">
      <%= group.global? ? "Everyone signed in" : "Members of #{group.name}" %> see these first on their home page, in this order.
    </p>

    <% if featured.any? %>
      <ul class="admin-group__list mb-4" role="list"
          data-controller="sortable-list"
          data-sortable-list-url-value="<%= reorder_team_featured_workflows_path(group) %>"
          data-sortable-list-param-value="featured_ids"
          data-sortable-list-query-value="<%= query %>">
        <% featured.each_with_index do |row, index| %>
          <% hidden = row.hidden_reason(visible_ids) %>
          <% can_move_up = !index.zero? %>
          <% can_move_down = index != featured.size - 1 %>
          <%# Move replaces this card, so focus goes back to the row that moved:
              its button the same way, or the other once it reaches an end. %>
          <% if row.id == moved_id %>
            <% focus = moved_direction %>
            <% focus = "down" if focus == "up" && !can_move_up %>
            <% focus = "up" if focus == "down" && !can_move_down %>
          <% end %>
          <li class="admin-group__item" data-sortable-id="<%= row.id %>">
            <span class="admin-folders__handle cursor-move" title="Drag to reorder" aria-hidden="true">
              <%= icon "bars-2", class: "icon icon--sm" %>
            </span>
            <span class="admin-group__name"><%= row.workflow.title %></span>
            <span class="admin-group__meta">
              <% if hidden %>
                <span class="badge badge--warning">Members can't see this</span> <%= hidden %> ·
              <% elsif row.past_the_kit?(visible_ids, kit) %>
                Past the first <%= GroupFeaturedWorkflow::MAX_PER_GROUP %> · not on members' home pages ·
              <% end %>
              Added by <%= row.added_by&.display_label || "a former user" %> <%= time_ago_in_words(row.created_at) %> ago
            </span>
            <% if can_move_up %>
              <%= button_to "Move up", move_team_featured_workflow_path(group, row), method: :patch,
                    params: { direction: "up", q: query }, class: "btn btn--plain btn--sm",
                    autofocus: focus == "up", aria: { label: "Move #{row.workflow.title} up" } %>
            <% end %>
            <% if can_move_down %>
              <%= button_to "Move down", move_team_featured_workflow_path(group, row), method: :patch,
                    params: { direction: "down", q: query }, class: "btn btn--plain btn--sm",
                    autofocus: focus == "down", aria: { label: "Move #{row.workflow.title} down" } %>
            <% end %>
            <%= button_to "Remove", team_featured_workflow_path(group, row), method: :delete,
                  params: { q: query }, class: "btn btn--plain btn--sm",
                  aria: { label: "Remove #{row.workflow.title} from #{group.name}" } %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="form-hint mb-4">Nothing featured yet. Find workflows below.</p>
    <% end %>

    <% if visible_count >= GroupFeaturedWorkflow::MAX_PER_GROUP %>
      <p class="form-hint mb-3">This team features the most it can. Remove one to add another.</p>
    <% end %>

    <%# The field sits outside the frame it fills, so answering as you type never
        replaces the input being typed in. %>
    <%= form_with url: team_featured_workflows_path(group), method: :get, class: "admin-group__search",
          data: { controller: "debounced-submit", turbo_frame: "team-featured-search" } do |form| %>
      <%= form.search_field :q, value: query, class: "form-input form-input--sm",
            placeholder: "Find workflows this team can see", autocomplete: "off",
            aria: { label: "Find workflows to feature for #{group.name}" },
            data: { action: "input->debounced-submit#submit" } %>
      <%= form.submit "Search", name: nil, class: "btn btn--secondary btn--sm" %>
    <% end %>
    <%= render "teams/featured_search", group:, query:, candidates: %>
  </div>
</section>
