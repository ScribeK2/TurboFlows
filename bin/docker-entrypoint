#!/bin/bash
set -e

# Active Storage uploads, and Puma's pidfile: .dockerignore leaves tmp/ out of
# the image, and Puma exits if it can't write tmp/pids/server.pid.
mkdir -p /rails/storage /rails/tmp/pids

# db:prepare creates the database on first boot and migrates on every boot after,
# for every database in config/database.yml — the queue included, so there is no
# separate queue step. `bin/rails db:prepare:queue` used to follow this line; Rails
# 8.1 has no such task, so with `set -e` the container exited before Puma started.
# Production's copy (on the internal GitLab) already had it commented out.
bin/rails db:prepare

exec "$@"
